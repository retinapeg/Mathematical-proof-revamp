diff --git a/eval/tests/test_agent.py b/eval/tests/test_agent.py
new file mode 100644
index 0000000000000000000000000000000000000000..62228f89466dec395a475c415faa3d5c9e6044c2
--- /dev/null
+++ b/eval/tests/test_agent.py
@@ -0,0 +1,197 @@
+from dataclasses import asdict
+import json
+from pathlib import Path
+import shutil
+import time
+
+import httpx
+import pytest
+
+from eval.harness.agent import extract_blocks, feedback, run_task
+from eval.harness.budget import Budget, BudgetStop
+from eval.harness.llm import Anthropic, Fake, OpenAICompatible
+from eval.harness.runner import read_rows, run
+from eval.harness.schema import Task
+
+META = {"git_sha": "a"*40, "isabelle_version": "Isabelle2025-2"}
+
+
+def strings(value):
+    if isinstance(value, str):
+        return [value]
+    if isinstance(value, dict):
+        return [s for child in value.values() for s in strings(child)]
+    if isinstance(value, list):
+        return [s for child in value for s in strings(child)]
+    return []
+
+
+def normalized_trace(path):
+    return [" ".join(s.split()) for s in strings(json.loads(path.read_text()))]
+
+
+def fixture_corpus(tmp_path):
+    source = [json.loads(x) for x in Path("eval/corpus/fresh.jsonl").read_text().splitlines()]
+    # Include an arithmetic step that simp alone cannot solve, as well as easy steps.
+    ids = ["fresh/Swarm/base", "fresh/Swarm/next_sum", "fresh/Swarm/next_square",
+           "fresh/Cascade/denominator_nonzero", "fresh/Swarm/induction_step"]
+    rows = [next(r for r in source if r["id"] == identity) for identity in ids]
+    for i, row in enumerate(rows):
+        # A distinct canary makes exact-string leak detection meaningful:
+        # ubiquitous output such as "by simp" is not evidence of an input leak.
+        row["held_out_proof"] += f" (* private_canary_{i}_8ae7 *)"
+    path = tmp_path / "corpus.jsonl"
+    path.write_text("".join(json.dumps(r)+"\n" for r in rows))
+    return path, rows
+
+
+def config(path, policy, attempts=1):
+    return {"run_id": "test_"+policy, "corpus": [str(path)],
+            "conditions": [{"model": "fake_"+policy, "provider": "fake",
+                            "policy": policy, "max_attempts": attempts}],
+            "workers": 2, "kernel_timeout_s": 30, "max_usd": 0, "max_hours": 1}
+
+
+def test_blocks_and_feedback():
+    assert extract_blocks("<aux>lemma h: \"True\" by simp</aux><proof>by simp</proof>")[0] == "by simp"
+    for text in ["by simp", "<proof>x</proof><proof>y</proof>", "prose <proof>x</proof>"]:
+        with pytest.raises(ValueError):
+            extract_blocks(text)
+    assert len(feedback("long\n"*1000)) <= 3000
+    assert len(feedback("long\n"*1000).splitlines()) == 40
+
+
+def test_public_task_boundary(tmp_path):
+    _, rows = fixture_corpus(tmp_path)
+    public = asdict(Task.from_row(rows[0]))
+    assert set(public) == {"id", "stratum", "imports", "statement", "orig_proof_lines"}
+    assert "private_canary" not in json.dumps(public)
+
+
+def test_sorry_never_calls_kernel(tmp_path, monkeypatch):
+    path, rows = fixture_corpus(tmp_path)
+    cfg = config(path, "sorry")
+    def forbidden(*args, **kwargs):
+        pytest.fail("Cheat text reached the kernel")
+    monkeypatch.setattr("eval.harness.agent.check", forbidden)
+    for row in rows:
+        result = run_task(Task.from_row(row), cfg["conditions"][0], cfg, META, 0, tmp_path)
+        assert result["failure_class"] == "cheat_rejected"
+        assert result["kernel_wall_s"] == 0
+    for row in rows:
+        private = " ".join(row["held_out_proof"].split())
+        for trace in (tmp_path / "traces").rglob("*.json"):
+            assert all(private not in s for s in normalized_trace(trace))
+            assert "private_canary" not in trace.read_text()
+
+
+def test_leak_detector_positive_control(tmp_path):
+    path, rows = fixture_corpus(tmp_path)
+    original = rows[-1]["held_out_proof"]
+    completion = Fake.from_corpus("held_out", [str(path)], rows[-1]["id"]).complete([], "fake")
+    trace = tmp_path / "positive.json"
+    trace.write_text(json.dumps(asdict(completion)))
+    assert any(" ".join(original.split()) in s for s in normalized_trace(trace))
+
+
+def test_provider_requests_and_full_response(monkeypatch):
+    monkeypatch.setenv("OPENAI_BASE_URL", "http://localhost:8000")
+    monkeypatch.setenv("OPENAI_API_KEY", "test-only-not-real")
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "test-only-not-real")
+    messages = [{"role": "system", "content": "rules"}, {"role": "user", "content": "statement"}]
+    def answer(request):
+        body = json.loads(request.content)
+        assert body["temperature"] == 0
+        if request.url.path == "/v1/chat/completions":
+            assert body["max_completion_tokens"] == 2048
+            return httpx.Response(200, json={"choices": [{"message": {"content": "<proof>by simp</proof>"}}],
+                "usage": {"prompt_tokens": 17, "completion_tokens": 9}, "model": "exact-snapshot-2026"})
+        assert body["system"] == "rules" and body["messages"] == messages[1:]
+        return httpx.Response(200, json={"content": [{"type": "text", "text": "<proof>by simp</proof>"}],
+            "usage": {"input_tokens": 18, "output_tokens": 10}, "model": "claude-exact-snapshot"})
+    for cls in [OpenAICompatible, Anthropic]:
+        result = cls(transport=httpx.MockTransport(answer)).complete(messages, "requested-alias")
+        assert result.raw_response["model"] == result.model_id
+        assert result.prompt_tokens in {17, 18}
+        assert not result.error
+        assert "test-only-not-real" not in json.dumps(asdict(result))
+
+
+def test_provider_error_is_one_call(monkeypatch):
+    monkeypatch.setenv("OPENAI_BASE_URL", "http://localhost/v1")
+    monkeypatch.setenv("OPENAI_API_KEY", "not-real")
+    calls = []
+    def answer(request):
+        calls.append(request)
+        return httpx.Response(500, text="complete error body")
+    result = OpenAICompatible(transport=httpx.MockTransport(answer)).complete([], "x")
+    assert len(calls) == 1 and result.error
+    assert result.raw_response == "complete error body" and not result.usage_known
+
+
+def test_malformed_answer_preserves_returned_model_and_billable_usage(monkeypatch):
+    monkeypatch.setenv("OPENAI_BASE_URL", "http://localhost/v1")
+    monkeypatch.setenv("OPENAI_API_KEY", "not-real")
+    def answer(request):
+        return httpx.Response(200, json={"model": "returned-snapshot",
+            "usage": {"prompt_tokens": 12, "completion_tokens": 7}, "choices": []})
+    result = OpenAICompatible(transport=httpx.MockTransport(answer)).complete([], "alias")
+    assert result.error and result.model_id == "returned-snapshot"
+    assert result.usage_known and (result.prompt_tokens, result.completion_tokens) == (12, 7)
+
+
+def test_budget_reservation_and_restart(tmp_path):
+    budget = Budget(tmp_path / "budget.sqlite", 1, 1)
+    budget.reserve("a", .8)
+    with pytest.raises(BudgetStop):
+        Budget(budget.path, 1, 1).reserve("b", .3)
+    budget.settle("a", .2)
+    budget.reserve("b", .3)
+    assert budget.total() == pytest.approx(.5)
+    with pytest.raises(BudgetStop):
+        budget.reserve("b", 0)
+    with pytest.raises(BudgetStop):
+        Budget(tmp_path / "zero.sqlite", 1, 0).reserve("c", 0)
+
+
+def test_retry_and_condition_trace_separation(tmp_path):
+    path, rows = fixture_corpus(tmp_path)
+    cfg = config(path, "garbage", 2)
+    task = Task.from_row(rows[0])
+    result = run_task(task, cfg["conditions"][0], cfg, META, 0, tmp_path)
+    assert result["attempt_failures"] == {"parse_error": 2}
+    cfg["conditions"][0]["model"] = "second"
+    run_task(task, cfg["conditions"][0], cfg, META, 2, tmp_path)
+    traces = sorted((tmp_path / "traces").rglob("*.json"))
+    assert len(traces) == 4
+    second = json.loads(traces[1].read_text())
+    assert second["messages"][-2]["content"] == "not an XML proof"
+    assert "Expected exactly one" in second["messages"][-1]["content"]
+
+
+@pytest.mark.isabelle
+@pytest.mark.skipif(not shutil.which("isabelle"), reason="Isabelle absent")
+def test_end_to_end_and_resume(tmp_path):
+    path, source = fixture_corpus(tmp_path)
+    for policy in ["held_out", "sorry", "simp"]:
+        cfg = config(path, policy)
+        status = run(cfg, tmp_path)
+        assert status["completed"] == 5 and status["status"] == "complete"
+        rows = read_rows(tmp_path / cfg["run_id"] / "results.jsonl")
+        if policy == "held_out":
+            assert all(r["proved"] for r in rows)
+        elif policy == "sorry":
+            assert all(r["failure_class"] == "cheat_rejected" and r["kernel_wall_s"] == 0 for r in rows)
+        else:
+            assert 0 < sum(r["proved"] for r in rows) < 5
+            assert all(r["proved"] or r["failure_class"] in {"method_failed", "unfinished_goal"} for r in rows)
+        traces = list((tmp_path / "traces" / cfg["run_id"]).rglob("*.json"))
+        assert len(traces) == 5
+        before = {p: p.stat().st_mtime_ns for p in traces}
+        assert run(cfg, tmp_path)["written"] == 0
+        assert before == {p: p.stat().st_mtime_ns for p in traces}
+        if policy != "held_out":
+            for original in source:
+                needle = " ".join(original["held_out_proof"].split())
+                assert all(needle not in s for p in traces for s in normalized_trace(p))
+                assert all("private_canary" not in p.read_text() for p in traces)
diff --git a/eval/tests/test_kernel.py b/eval/tests/test_kernel.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbad9aeea6cc8597b5f4b0bb7d80602d6da90588
--- /dev/null
+++ b/eval/tests/test_kernel.py
@@ -0,0 +1,79 @@
+import json
+from pathlib import Path
+import shutil
+
+import pytest
+
+from eval.harness.assemble import assemble, theory_name
+from eval.harness.classify import classify
+from eval.harness.kernel import KernelResult, check, parse_errors, proved
+from eval.harness.scanner import FORBIDDEN, scan
+
+
+@pytest.mark.parametrize("word", sorted(FORBIDDEN))
+def test_forbidden(word):
+    assert scan(f"by simp (* {word} *)")
+
+
+@pytest.mark.parametrize("proof", [
+    "by simp", "by (simp add: append_assoc)",
+    'proof -\n have weekend: "True" by simp\n show ?thesis using weekend .\nqed',
+])
+def test_allowed(proof):
+    assert not scan(proof)
+
+
+def test_scanner_boundaries():
+    assert scan("by simp", "lemma target: \"True\" by simp", "target")
+    assert not scan("by simp", "lemma helpful: \"True\" by simp", "target")
+    assert scan("x" * 8001)
+    assert scan("by (tactic ‹Skip_Proof.cheat_tac @{context} 1›)")
+    assert scan("*) lemma fake: \"True\" by simp", "(*")
+    assert scan("by simp", 'lemma "target": "True" by simp', "target")
+    assert scan('by simp (*')
+    assert not scan('by simp (* outer (* nested *) comment *)')
+
+
+def test_assembly():
+    statement = 'lemma exact:\n  fixes x :: nat\n  shows "x = x"  '
+    text = assemble(statement, ["Main"], "by simp", lemma_id="a", run_id="b", attempt=3)
+    assert f"\n{statement}\n" in text
+    assert theory_name("a", "b", 3) in text
+    assert theory_name("a", "b", 3) != theory_name("a", "b", 4)
+    clean = KernelResult(0, "", "", [], 0, False)
+    assert proved(clean, text, statement, "by simp")
+    assert not proved(clean, text, statement + " altered", "by simp")
+    assert not proved(clean, text, statement, "sorry")
+    assert not proved(KernelResult(0, "", "", parse_errors("*** failure"), 0, False),
+                      text, statement, "by simp")
+
+
+@pytest.mark.parametrize("fixture,expected", [
+    ("syntax_error", "parse_error"), ("unknown_fact", "unknown_fact"),
+    ("method_failed", "method_failed"),
+])
+def test_real_error_fixtures(fixture, expected):
+    data = json.loads((Path(__file__).parent / "fixtures" / f"{fixture}.json").read_text())
+    errors = parse_errors(data["stdout"], data["stderr"])
+    assert any(e.line in {4, 5} for e in errors)
+    assert all(e.col is None for e in errors)
+    assert classify(KernelResult(data["exit_code"], data["stdout"], data["stderr"],
+                                 errors, data["wall_s"], False)) == expected
+
+
+@pytest.mark.isabelle
+@pytest.mark.skipif(not shutil.which("isabelle"), reason="Isabelle absent")
+@pytest.mark.parametrize("filename,expected", [("Swarm_solution", True), ("Swarm", False)])
+def test_real_swarm(tmp_path, filename, expected):
+    text = Path(f"examples/{filename}.thy").read_text()
+    statement = next(line for line in text.splitlines() if line.startswith("theorem "))
+    body = text.split("begin", 1)[1].rsplit("end", 1)[0]
+    result = check(text, tmp_path / filename, 60)
+    assert proved(result, text, statement, body) == expected
+
+
+@pytest.mark.isabelle
+@pytest.mark.skipif(not shutil.which("isabelle"), reason="Isabelle absent")
+def test_timeout(tmp_path):
+    result = check(assemble('lemma timeout_probe: "True"', ["Main"], "by simp"), tmp_path, .1)
+    assert result.timed_out and not proved(result, "", "True", "by simp")
diff --git a/eval/tests/test_report.py b/eval/tests/test_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..3b8629b2b45b739969edfa4c527e5311cb41b76f
--- /dev/null
+++ b/eval/tests/test_report.py
@@ -0,0 +1,44 @@
+import json
+
+from eval.harness.report import bucket, generate, wilson
+from eval.harness.schema import Result
+
+
+def test_wilson_reference_values():
+    assert wilson(0, 0) is None
+    lo, hi = wilson(0, 10)
+    assert abs(lo) < 1e-12 and abs(hi - .2775328) < 1e-6
+    lo, hi = wilson(5, 10)
+    assert abs(lo - .2365931) < 1e-6 and abs(hi - .7634069) < 1e-6
+    assert [bucket(n) for n in [1, 2, 3, 4, 8, 9]] == ["1", "2–3", "2–3", "4–8", "4–8", "9+"]
+
+
+def result(model, identity, proved, attempts, failures, lines, cost=0):
+    return Result(
+        run_id="test", lemma_id=identity, stratum="fresh",
+        condition={"model": model, "max_attempts": 8 if model == "tactics" else 4},
+        proved=proved, attempts_used=attempts, failure_class=None if proved else "method_failed",
+        final_error="", proof_text="by simp", proof_lines=1, methods_used={"simp": 1},
+        aux_lemmas="", prompt_tokens=10, completion_tokens=10, usd_cost=cost,
+        llm_wall_s=1, kernel_wall_s=2, model_id_returned="exact-model",
+        isabelle_version="Isabelle2025-2", git_sha="a"*40, timestamp="test",
+        orig_proof_lines=lines, attempt_failures=failures, model_ids_returned=["exact-model"],
+        provider="tactics" if model == "tactics" else "openai_compatible").to_dict()
+
+
+def test_report_attempt_denominator_paired_comparison_and_reproducibility(tmp_path):
+    full, baseline = tmp_path / "full", tmp_path / "tactics"
+    full.mkdir()
+    baseline.mkdir()
+    rows = [result("model", "a", True, 2, {"unknown_fact": 1}, 1, .2),
+            result("model", "b", False, 4, {"method_failed": 4}, 9, .3)]
+    battery = [result("tactics", "a", False, 8, {"method_failed": 8}, 1),
+               result("tactics", "b", True, 1, {}, 9)]
+    for directory, data in [(full, rows), (baseline, battery)]:
+        (directory / "results.jsonl").write_text("".join(json.dumps(r)+"\n" for r in data))
+    text = generate(full)
+    assert "1/5 (20.0%)" in text  # Failed attempts, not just final failed rows.
+    assert "| model | 4 | fresh | 2 | 1 | 1 |" in text
+    assert "$0.500000" in text  # All spending, including failed lemma, per one success.
+    assert text.index("| tactics |") < text.index("| model |")
+    assert text == generate(full)
diff --git a/eval/tests/test_tactics.py b/eval/tests/test_tactics.py
new file mode 100644
index 0000000000000000000000000000000000000000..f67be9d8fdc999529550d066cf9df2d5844bb6b7
--- /dev/null
+++ b/eval/tests/test_tactics.py
@@ -0,0 +1,26 @@
+from eval.harness.schema import Task
+from eval.harness.tactics import TACTICS, run_tactics
+
+
+def test_battery_order_timeout_and_early_stop(tmp_path, monkeypatch):
+    calls = []
+    def assess(task, proof, aux, run_id, ordinal, root, timeout, keep):
+        calls.append((proof, timeout))
+        success = proof == "by blast"
+        return {"proved": success, "proof_text": proof, "aux_lemmas": "",
+                "failure_class": None if success else "method_failed",
+                "error": "" if success else "Failed to finish proof", "kernel_wall_s": 1}
+    monkeypatch.setattr("eval.harness.tactics.assess", assess)
+    task = Task("test/example", "fresh", ["Main"], 'lemma t: "True"', 1)
+    condition = {"model": "tactics", "provider": "tactics", "max_attempts": 8}
+    config = {"run_id": "tactics", "max_hours": 8}
+    metadata = {"git_sha": "a"*40, "isabelle_version": "test-version"}
+    row = run_tactics(task, condition, config, metadata, 0, tmp_path)
+    assert calls == [(s, 30) for s in ["by simp", "by auto", "by blast"]]
+    assert row["proved"] and row["attempts_used"] == 3
+    assert row["usd_cost"] == 0 and row["model_id_returned"] is None
+    assert row["attempt_failures"] == {"method_failed": 2}
+    assert TACTICS[-1] == "by (simp add: algebra_simps)" and len(TACTICS) == 8
+    assert not any("metis" in s or "induction" in s for s in TACTICS)
+    run_tactics(task, condition, config, metadata, 0, tmp_path)
+    assert len(calls) == 3
