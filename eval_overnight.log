+            (root.parent / "statistics.json").write_text(json.dumps({
+                "isabelle_version": version, "lib": statistics(saved[0]),
+                "fresh": statistics(saved[1])}, indent=2)+"\n")
+            shutil.rmtree(root)
+            print("M1 validation passed (retained committed corpus snapshot)", flush=True)
+            return
+    if args.rebuild:
+        # Old group timeouts are not permanent negative judgments on candidates.
+        cache = {key: accepted for key, accepted in cache.items() if accepted}
     groups: dict[str, list[dict]] = defaultdict(list)
     for path in sorted(hol.glob("*.thy")) + sorted((hol / "Library").glob("*.thy")):
         for candidate in extract(path, str(path.relative_to(hol))):
diff --git a/eval/harness/agent.py b/eval/harness/agent.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f267be7b175193815e436f502569d8b26eadf2d
--- /dev/null
+++ b/eval/harness/agent.py
@@ -0,0 +1,209 @@
+"""A proof-only agent with durable, per-call traces and kernel feedback."""
+from __future__ import annotations
+
+from collections import Counter
+from dataclasses import asdict
+from datetime import datetime, timezone
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import tempfile
+import time
+
+from .assemble import assemble, target_name
+from .budget import Budget, BudgetStop, available_usd
+from .classify import classify
+from .kernel import check, proved
+from .llm import Anthropic, Completion, Fake, OpenAICompatible, Provider
+from .scanner import scan
+from .schema import Result, Task
+
+SYSTEM_PROMPT = """Prove the supplied canonical Isabelle lemma using its existing imports.
+Write readable structured Isar: named have steps with one-line by justifications.
+Prefer a flat chain; use nested proof/qed only when fix/assume is needed.
+Prefer simp or rule over auto when they express the mathematics.
+try0 is allowed. Never use sledgehammer or nitpick. No new imports.
+Never use sorry, oops, axioms, ML, setup, declarations or proof-skipping tricks.
+Do not change or repeat the target statement.
+Respond only with <proof>proof text</proof>, optionally preceded by
+<aux>proved auxiliary lemmas</aux>. Auxiliary lemmas cannot reuse the target name.
+Only the Isabelle kernel determines whether a proof succeeds."""
+
+
+def atomic_json(path: Path, data: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(".tmp")
+    with temporary.open("w") as out:
+        json.dump(data, out, ensure_ascii=False, indent=2)
+        out.write("\n")
+        out.flush()
+        os.fsync(out.fileno())
+    temporary.replace(path)
+
+
+def extract_blocks(text: str) -> tuple[str, str]:
+    match = re.fullmatch(r"\s*(?:<aux>(.*?)</aux>\s*)?<proof>(.*?)</proof>\s*", text, re.S)
+    if not match or "<proof>" in match[2] or "</proof>" in match[2]:
+        raise ValueError("Expected exactly one <proof> block and optional preceding <aux>")
+    return match[2].strip(), (match[1] or "").strip()
+
+
+def feedback(error: str) -> str:
+    return "\n".join(error.splitlines()[:40])[:3000]
+
+
+def assess(task: Task, proof: str, aux: str, run_id: str, ordinal: int,
+           root: Path, timeout_s: float, keep_work: bool = False) -> dict:
+    outcome = {"proof_text": proof, "aux_lemmas": aux, "proved": False,
+               "failure_class": None, "error": "", "kernel_wall_s": 0.}
+    reasons = scan(proof, aux, target_name(task.statement))
+    if reasons:
+        return {**outcome, "failure_class": "cheat_rejected", "error": "\n".join(reasons)}
+    work_root = root / run_id / "work"
+    work_root.mkdir(parents=True, exist_ok=True)
+    directory = Path(tempfile.mkdtemp(prefix="attempt_", dir=work_root))
+    try:
+        theory = assemble(task.statement, task.imports, proof, aux, lemma_id=task.id,
+                          run_id=run_id, attempt=ordinal)
+        result = check(theory, directory, timeout_s)
+        accepted = proved(result, theory, task.statement, proof, aux, target_name(task.statement))
+        return {**outcome, "proved": accepted,
+                "failure_class": None if accepted else classify(result),
+                "error": "\n".join(e.message for e in result.errors) or
+                         (result.stderr if not accepted else ""),
+                "kernel_wall_s": result.wall_s, "kernel": asdict(result)}
+    finally:
+        if not keep_work:
+            shutil.rmtree(directory)
+
+
+def method_counts(text: str) -> dict[str, int]:
+    from eval.corpus.build_corpus import lex
+    names = "simp auto blast metis fastforce force arith linarith induction try0".split()
+    try:
+        tokens = [t.value for t in lex(text)
+                  if not t.value.startswith(('"', "‹", r"\<open>"))]
+    except ValueError:
+        tokens = []
+    counts = Counter(tokens)
+    result = {name: counts[name] for name in names}
+    result["induction"] += counts["induct"]
+    # Other counts explicit by invocations with an unlisted first method.
+    result["other"] = sum(m not in names + ["induct"] for m in
+                          re.findall(r"\bby\s+\(?\s*([A-Za-z_][\w']*)", " ".join(tokens)))
+    return result
+
+
+def summarize(task: Task, condition: dict, run_id: str, records: list[dict],
+              metadata: dict) -> dict:
+    last = records[-1]["result"]
+    completions = [r.get("completion", {}) for r in records]
+    ids = [c["model_id"] for c in completions if c.get("model_id")]
+    failures = Counter(r["result"]["failure_class"] for r in records if not r["result"]["proved"])
+    row = Result(
+        run_id, task.id, task.stratum,
+        {"model": condition["model"], "max_attempts": condition["max_attempts"]},
+        last["proved"], len(records), last["failure_class"], last["error"][:500],
+        last["proof_text"], len(last["proof_text"].splitlines()),
+        method_counts(last["proof_text"] + "\n" + last["aux_lemmas"]),
+        last["aux_lemmas"], sum(c.get("prompt_tokens", 0) for c in completions),
+        sum(c.get("completion_tokens", 0) for c in completions),
+        sum(r.get("usd_cost", 0.) for r in records), sum(c.get("wall_s", 0.) for c in completions),
+        sum(r["result"]["kernel_wall_s"] for r in records), ids[-1] if ids else None,
+        metadata["isabelle_version"], metadata["git_sha"], datetime.now(timezone.utc).isoformat(),
+        task.orig_proof_lines, dict(failures), sorted(set(ids)),
+        any(r.get("cost_is_upper_bound", False) for r in records), condition["provider"])
+    return row.to_dict()
+
+
+def provider_for(condition: dict, config: dict, task: Task, timeout: float) -> Provider:
+    if condition["provider"] == "fake":
+        return Fake.from_corpus(condition.get("policy", "simp"), config["corpus"], task.id)
+    cls = {"openai_compatible": OpenAICompatible, "anthropic": Anthropic}[condition["provider"]]
+    return cls(max_tokens=config.get("max_completion_tokens", 2048), timeout_s=timeout,
+               supports_temperature=condition.get("supports_temperature", True),
+               token_parameter=condition.get("token_parameter", "max_completion_tokens"))
+
+
+def deadline_expired(signum: int, frame: object) -> None:
+    raise TimeoutError("LLM wall-clock deadline reached")
+
+
+def run_task(task: Task, condition: dict, config: dict, metadata: dict,
+             offset: int, root: Path, keep_work: bool = False) -> dict | None:
+    run_id = config["run_id"]
+    budget = Budget(root / run_id / "budget.sqlite", available_usd(config), config.get("max_hours", 8))
+    messages = [{"role": "system", "content": SYSTEM_PROMPT},
+                {"role": "user", "content": f"imports {' '.join(task.imports)}\n\n{task.statement}"}]
+    records = []
+    rates = config.get("cost_usd_per_m", {}).get(condition["model"], {"prompt": 0, "completion": 0})
+    for attempt in range(1, condition["max_attempts"] + 1):
+        ordinal = offset + attempt
+        path = root / "traces" / run_id / task.id / f"attempt_{ordinal}.json"
+        if path.exists():
+            record = json.loads(path.read_text())
+            if "completion" not in record:
+                raise BudgetStop(f"Interrupted call without a response: {path}; no automatic retry")
+        else:
+            max_tokens = config.get("max_completion_tokens", 2048)
+            # Byte-level upper bound plus generous message framing allowance.
+            input_bound = len(json.dumps(messages, ensure_ascii=False).encode()) + 4096
+            upper_bound = (input_bound * rates["prompt"] + max_tokens * rates["completion"]) / 1e6
+            budget.reserve(str(path), upper_bound)
+            record = {"run_id": run_id, "lemma_id": task.id, "condition": condition,
+                      "attempt": attempt, "trace_ordinal": ordinal, "messages": list(messages),
+                      "requested_model": condition["model"], "reserved_usd": upper_bound,
+                      **metadata}
+            atomic_json(path, record)  # Write before the call, even if the process dies.
+            timeout = min(config.get("provider_timeout_s", 120), budget.remaining_s())
+            provider = provider_for(condition, config, task, max(.001, timeout))
+            old_handler = signal.signal(signal.SIGALRM, deadline_expired)
+            signal.setitimer(signal.ITIMER_REAL, max(.001, timeout))
+            started = time.monotonic()
+            try:
+                completion = provider.complete(messages, condition["model"])
+            except Exception as exc:
+                completion = Completion("", 0, 0, None, time.monotonic() - started,
+                                        error=type(exc).__name__, usage_known=False)
+            finally:
+                signal.setitimer(signal.ITIMER_REAL, 0)
+                signal.signal(signal.SIGALRM, old_handler)
+            record["completion"] = asdict(completion)
+            record["cost_is_upper_bound"] = not completion.usage_known
+            record["usd_cost"] = ((completion.prompt_tokens * rates["prompt"]
+                                   + completion.completion_tokens * rates["completion"]) / 1e6
+                                  if completion.usage_known else upper_bound)
+            atomic_json(path, record)  # Full raw response before parsing or checking.
+            budget.settle(str(path), record["usd_cost"])
+        completion = Completion(**record["completion"])
+        # Idempotent reconciliation covers crashes between trace write and settlement.
+        budget.settle(str(path), record["usd_cost"])
+        if "result" not in record:
+            if completion.error:
+                outcome = {"proved": False, "failure_class": "provider_error",
+                           "error": completion.error, "proof_text": "", "aux_lemmas": "", "kernel_wall_s": 0.}
+            else:
+                try:
+                    proof, aux = extract_blocks(completion.text)
+                except ValueError as exc:
+                    outcome = {"proved": False, "failure_class": "parse_error", "error": str(exc),
+                               "proof_text": "", "aux_lemmas": "", "kernel_wall_s": 0.}
+                else:
+                    remaining = budget.remaining_s()
+                    if remaining <= 0:
+                        raise BudgetStop("wall-clock limit before kernel check")
+                    outcome = assess(task, proof, aux, run_id, ordinal, root,
+                                     min(config["kernel_timeout_s"], remaining), keep_work)
+            record["result"] = outcome
+            atomic_json(path, record)
+        records.append(record)
+        if record["result"]["proved"]:
+            break
+        # Previous response includes the proof and any auxiliary lemmas verbatim.
+        messages += [{"role": "assistant", "content": completion.text},
+                     {"role": "user", "content": "Kernel/checker feedback:\n" +
+                      feedback(record["result"]["error"])}]
+    return summarize(task, condition, run_id, records, metadata)
diff --git a/eval/harness/assemble.py b/eval/harness/assemble.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d9980dcec1027fac5892d9b3faa62c38e1a5278
--- /dev/null
+++ b/eval/harness/assemble.py
@@ -0,0 +1,27 @@
+"""The harness alone owns theory headers and canonical statements."""
+from __future__ import annotations
+
+import hashlib
+import re
+
+
+def theory_name(lemma_id: str, run_id: str, attempt: int | str) -> str:
+    return "E_" + hashlib.sha1((lemma_id + run_id + str(attempt)).encode()).hexdigest()[:10]
+
+
+def target_name(statement: str) -> str:
+    match = re.match(r"(?:lemma|theorem|corollary)\s+([\w']+)\s*:", statement)
+    if not match:
+        raise ValueError("Expected one named canonical declaration")
+    return match[1]
+
+
+def assemble(statement: str, imports: list[str], proof_text: str,
+             aux_lemmas: str = "", *, lemma_id: str = "", run_id: str = "",
+             attempt: int | str = 1) -> str:
+    target_name(statement)
+    if not imports or any(i not in {"Main", "Complex_Main"} for i in imports):
+        raise ValueError("Only Main / Complex_Main imports are allowed")
+    name = theory_name(lemma_id or statement, run_id, attempt)
+    return (f"theory {name}\nimports {' '.join(imports)}\nbegin\n"
+            f"{aux_lemmas}\n{statement}\n{proof_text}\nend\n")
diff --git a/eval/harness/budget.py b/eval/harness/budget.py
new file mode 100644
index 0000000000000000000000000000000000000000..9d38c28f9bf15973ae7938d5c55ee1ae053f9535
--- /dev/null
+++ b/eval/harness/budget.py
@@ -0,0 +1,55 @@
+"""Persistent, process-safe reservations; interrupted calls keep their reservation."""
+from __future__ import annotations
+
+from pathlib import Path
+import sqlite3
+import time
+
+
+class BudgetStop(Exception):
+    pass
+
+
+def available_usd(config: dict) -> float:
+    """Smoke spending shares the fixed full-run ceiling."""
+    return max(0., config["max_usd"] - config.get("prior_usd_cost", 0.))
+
+
+class Budget:
+    def __init__(self, path: Path, max_usd: float, max_hours: float):
+        self.path, self.max_usd, self.max_hours = path, max_usd, max_hours
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with self.connect() as db:
+            db.execute("CREATE TABLE IF NOT EXISTS clock (started REAL)")
+            db.execute("INSERT INTO clock SELECT ? WHERE NOT EXISTS (SELECT 1 FROM clock)", (time.time(),))
+            db.execute("CREATE TABLE IF NOT EXISTS calls (id TEXT PRIMARY KEY, usd REAL, settled INTEGER)")
+
+    def connect(self) -> sqlite3.Connection:
+        return sqlite3.connect(self.path, timeout=30)
+
+    def remaining_s(self) -> float:
+        with self.connect() as db:
+            start = db.execute("SELECT started FROM clock").fetchone()[0]
+        return max(0., self.max_hours * 3600 - (time.time() - start))
+
+    def reserve(self, identity: str, upper_bound: float) -> None:
+        if self.remaining_s() <= 0:
+            raise BudgetStop("wall-clock limit reached")
+        with self.connect() as db:
+            db.execute("BEGIN IMMEDIATE")
+            if db.execute("SELECT 1 FROM calls WHERE id=?", (identity,)).fetchone():
+                raise BudgetStop("request already reserved; refusing an ambiguous repeat")
+            total = db.execute("SELECT COALESCE(SUM(usd),0) FROM calls").fetchone()[0]
+            if total + upper_bound > self.max_usd + 1e-12:
+                raise BudgetStop("LLM budget cannot cover the next bounded request")
+            db.execute("INSERT INTO calls VALUES (?,?,0)", (identity, upper_bound))
+
+    def settle(self, identity: str, actual: float) -> None:
+        with self.connect() as db:
+            updated = db.execute("UPDATE calls SET usd=?, settled=1 WHERE id=?", (actual, identity))
+            if updated.rowcount != 1:
+                raise BudgetStop("missing reservation; refusing to lose historical spend")
+
+    def total(self) -> float:
+        with self.connect() as db:
+            return db.execute("SELECT COALESCE(SUM(usd),0) FROM calls").fetchone()[0]
diff --git a/eval/harness/classify.py b/eval/harness/classify.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d3e79b27b8769ebc319f6f3b7ca0019b2534404
--- /dev/null
+++ b/eval/harness/classify.py
@@ -0,0 +1,27 @@
+"""Stable, ordered error categories; the original error remains in the trace."""
+from __future__ import annotations
+
+import re
+from .kernel import KernelResult
+
+FAILURES = ("parse_error", "unknown_fact", "method_failed", "unfinished_goal",
+            "type_error", "timeout", "cheat_rejected", "provider_error", "other")
+PATTERNS = [
+    ("parse_error", r"Outer syntax error|Inner syntax error|Bad name"),
+    ("unknown_fact", r"Undefined fact|Unknown fact|Undefined type name|Undeclared"),
+    ("type_error", r"Type unification failed|Type error"),
+    ("method_failed", r"Failed to finish proof|Failed to apply initial proof method|empty result sequence"),
+    ("unfinished_goal", r"Failed to refine|unfinished|goal"),
+]
+
+
+def classify(result: KernelResult, *, cheat: bool = False) -> str:
+    if result.timed_out:
+        return "timeout"
+    if cheat:
+        return "cheat_rejected"
+    text = "\n".join(error.message for error in result.errors)
+    for category, pattern in PATTERNS:
+        if re.search(pattern, text, re.IGNORECASE):
+            return category
+    return "other"
diff --git a/eval/harness/kernel.py b/eval/harness/kernel.py
new file mode 100644
index 0000000000000000000000000000000000000000..98f29333f409c0af518b0ad0ac770947d133bd18
--- /dev/null
+++ b/eval/harness/kernel.py
@@ -0,0 +1,66 @@
+"""One attempt, one directory, one headless kernel invocation."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+import re
+
+from eval.probe_m0 import run
+from .scanner import scan
+
+
+@dataclass(frozen=True)
+class KernelError:
+    line: int | None
+    col: int | None
+    message: str
+
+
+@dataclass(frozen=True)
+class KernelResult:
+    exit_code: int
+    stdout: str
+    stderr: str
+    errors: list[KernelError]
+    wall_s: float
+    timed_out: bool
+
+
+def parse_errors(stdout: str, stderr: str = "") -> list[KernelError]:
+    errors: list[KernelError] = []
+    position: int | None = None
+    for line in (stdout + "\n" + stderr).splitlines():
+        if re.match(r"^(Error\b|\*\*\*)", line):
+            loc = re.search(r"\bline (\d+)", line)
+            if loc:
+                position = int(loc[1])
+            col = re.search(r"\bcolumn (\d+)", line)
+            error = KernelError(position, int(col[1]) if col else None,
+                                re.sub(r"^\*\*\*\s?", "", line))
+            if error not in errors:
+                errors.append(error)
+        elif re.search(r"\bFAILED\b|^Unfinished session|^Exception", line):
+            errors.append(KernelError(None, None, line))
+    return errors
+
+
+def check(theory_text: str, workdir: str | Path, timeout_s: float) -> KernelResult:
+    directory = Path(workdir)
+    directory.mkdir(parents=True, exist_ok=True)
+    match = re.match(r"theory\s+([A-Za-z_][\w']*)\b", theory_text)
+    if not match:
+        raise ValueError("Missing safe theory name")
+    path = directory / (match[1] + ".thy")
+    path.write_text(theory_text, encoding="utf-8")
+    outcome = run(["isabelle", "process_theories", "-D", str(directory.resolve()),
+                   "-O", "-o", "quick_and_dirty=false", match[1]], timeout_s)
+    return KernelResult(outcome["exit_code"], outcome["stdout"], outcome["stderr"],
+                        parse_errors(outcome["stdout"], outcome["stderr"]),
+                        outcome["wall_s"], outcome["timed_out"])
+
+
+def proved(result: KernelResult, theory_text: str, statement: str,
+           proof_text: str, aux_lemmas: str = "", target: str = "") -> bool:
+    return (result.exit_code == 0 and not result.timed_out and not result.errors
+            and bool(statement) and statement in theory_text
+            and not scan(proof_text, aux_lemmas, target))
diff --git a/eval/harness/llm.py b/eval/harness/llm.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d8d7809d41703998fa5674b5577a39c9d35a9a0
--- /dev/null
+++ b/eval/harness/llm.py
@@ -0,0 +1,132 @@
+"""Single-request providers. No implicit HTTP retries and no embedded credentials."""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import json
+import os
+from pathlib import Path
+import time
+from typing import Protocol
+
+import httpx
+
+
+@dataclass
+class Completion:
+    text: str
+    prompt_tokens: int
+    completion_tokens: int
+    model_id: str | None
+    wall_s: float
+    raw_response: dict | str = field(default_factory=dict)
+    request: dict = field(default_factory=dict)
+    error: str = ""
+    usage_known: bool = True
+
+
+class Provider(Protocol):
+    def complete(self, messages: list[dict], model: str) -> Completion: ...
+
+
+class OpenAICompatible:
+    def __init__(self, *, max_tokens: int = 2048, timeout_s: float = 120,
+                 supports_temperature: bool = True, token_parameter: str = "max_completion_tokens",
+                 transport: httpx.BaseTransport | None = None):
+        if token_parameter not in {"max_tokens", "max_completion_tokens"}:
+            raise ValueError("Invalid output token parameter")
+        self.max_tokens, self.timeout_s = max_tokens, timeout_s
+        self.supports_temperature, self.token_parameter = supports_temperature, token_parameter
+        self.transport = transport
+
+    def endpoint(self) -> tuple[str, dict]:
+        base = os.environ["OPENAI_BASE_URL"].rstrip("/")
+        if not base.endswith("/v1"):
+            base += "/v1"
+        return base + "/chat/completions", {"Authorization": "Bearer " + os.environ["OPENAI_API_KEY"]}
+
+    def payload(self, messages: list[dict], model: str) -> dict:
+        data = {"model": model, "messages": messages, self.token_parameter: self.max_tokens}
+        if self.supports_temperature:
+            data["temperature"] = 0
+        return data
+
+    def decode(self, data: dict) -> tuple[str, int, int, str]:
+        return (data["choices"][0]["message"]["content"], data["usage"]["prompt_tokens"],
+                data["usage"]["completion_tokens"], data["model"])
+
+    def complete(self, messages: list[dict], model: str) -> Completion:
+        start = time.monotonic()
+        payload = self.payload(messages, model)
+        raw: dict | str = ""
+        try:
+            url, headers = self.endpoint()
+            # No redirects, tool calls, streaming, automatic retries or prompt caching.
+            with httpx.Client(timeout=self.timeout_s, transport=self.transport) as client:
+                response = client.post(url, headers=headers, json=payload)
+            try:
+                raw = response.json()
+            except ValueError:
+                raw = response.text
+            response.raise_for_status()
+            if not isinstance(raw, dict):
+                raise ValueError("Expected a JSON object")
+            text, pt, ct, actual = self.decode(raw)
+            if not isinstance(text, str) or not actual or min(pt, ct) < 0:
+                raise ValueError("Missing text, exact model id, or valid usage")
+            return Completion(text, pt, ct, actual, time.monotonic()-start, raw, payload)
+        except (httpx.HTTPError, KeyError, ValueError, TypeError, IndexError) as exc:
+            # Never serialize exception text that might contain request headers/keys.
+            status = exc.response.status_code if isinstance(exc, httpx.HTTPStatusError) else None
+            known_free = isinstance(exc, KeyError) and raw == "" or status in {400, 401, 403, 404, 422, 429}
+            usage = raw.get("usage", {}) if isinstance(raw, dict) else {}
+            pt = usage.get("prompt_tokens", usage.get("input_tokens"))
+            ct = usage.get("completion_tokens", usage.get("output_tokens"))
+            known_usage = isinstance(pt, int) and isinstance(ct, int) and min(pt, ct) >= 0
+            actual = raw.get("model") if isinstance(raw, dict) else None
+            return Completion("", pt if known_usage else 0, ct if known_usage else 0,
+                              actual, time.monotonic()-start, raw, payload,
+                              f"{type(exc).__name__}; HTTP status={status}", known_free or known_usage)
+
+
+class Anthropic(OpenAICompatible):
+    def endpoint(self) -> tuple[str, dict]:
+        return "https://api.anthropic.com/v1/messages", {
+            "x-api-key": os.environ["ANTHROPIC_API_KEY"], "anthropic-version": "2023-06-01"}
+
+    def payload(self, messages: list[dict], model: str) -> dict:
+        data = {"model": model, "max_tokens": self.max_tokens,
+                "system": "\n".join(m["content"] for m in messages if m["role"] == "system"),
+                "messages": [m for m in messages if m["role"] != "system"]}
+        if self.supports_temperature:
+            data["temperature"] = 0
+        return data
+
+    def decode(self, data: dict) -> tuple[str, int, int, str]:
+        usage = data["usage"]
+        return ("".join(b["text"] for b in data["content"] if b["type"] == "text"),
+                usage["input_tokens"], usage["output_tokens"], data["model"])
+
+
+class Fake:
+    def __init__(self, policy: str, proof: str = ""):
+        if policy not in {"held_out", "simp", "sorry", "garbage"}:
+            raise ValueError("Unknown fake policy")
+        self.policy, self.proof, self.calls = policy, proof, 0
+
+    @classmethod
+    def from_corpus(cls, policy: str, paths: list[str], lemma_id: str) -> Fake:
+        if policy != "held_out":
+            return cls(policy)
+        for path in paths:
+            for line in Path(path).read_text().splitlines():
+                row = json.loads(line)
+                if row["id"] == lemma_id:
+                    return cls(policy, row["held_out_proof"])
+        raise ValueError("Fake held-out fixture not found")
+
+    def complete(self, messages: list[dict], model: str) -> Completion:
+        self.calls += 1
+        text = {"held_out": self.proof, "simp": "by simp", "sorry": "sorry",
+                "garbage": "not an XML proof"}[self.policy]
+        response = text if self.policy == "garbage" else f"<proof>{text}</proof>"
+        return Completion(response, 0, 0, "fake/" + self.policy, 0, {"text": response})
diff --git a/eval/harness/report.py b/eval/harness/report.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b2553ed9c3dc137be1bf37ff30913904b8e638d
--- /dev/null
+++ b/eval/harness/report.py
@@ -0,0 +1,242 @@
+"""Regenerate descriptive tables from validated JSONL rows, never from prose."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter, defaultdict
+from dataclasses import asdict
+import json
+import math
+from pathlib import Path
+import sqlite3
+import statistics
+import subprocess
+
+from .classify import FAILURES
+from .runner import load_tasks, read_rows
+
+
+def wilson(successes: int, total: int) -> tuple[float, float] | None:
+    if not total:
+        return None
+    z = 1.959963984540054
+    p, scale = successes / total, 1 + z*z/total
+    center = (p + z*z/(2*total)) / scale
+    radius = z * math.sqrt(p*(1-p)/total + z*z/(4*total*total)) / scale
+    return max(0., center-radius), min(1., center+radius)
+
+
+def bucket(lines: int) -> str:
+    return "1" if lines == 1 else "2–3" if lines <= 3 else "4–8" if lines <= 8 else "9+"
+
+
+def report_directory(value: str) -> Path:
+    directory = Path(value)
+    if directory.parts and directory.parts[0] == "results" and Path("eval").is_dir():
+        directory = Path("eval") / directory
+    return directory
+
+
+def table(headers: list[str], rows: list[list]) -> str:
+    def cell(value: object) -> str:
+        return str(value).replace("|", "\\|").replace("\n", " ")
+    return "\n".join(["| " + " | ".join(headers) + " |",
+                      "| " + " | ".join("---" for _ in headers) + " |"] +
+                     ["| " + " | ".join(map(cell, row)) + " |" for row in rows]) + "\n"
+
+
+def proportion(rows: list[dict]) -> str:
+    n = len(rows)
+    s = sum(r["proved"] for r in rows)
+    return f"{s}/{n} ({100*s/n:.1f}%)" if n else "NA (0 completed)"
+
+
+def prepare_partial(directory: Path, config: dict, reason: str) -> None:
+    """Report an unavailable run without reserving its run_id or starting its clock."""
+    if (directory / "manifest.json").exists():
+        return
+    from .agent import atomic_json
+    directory.mkdir(parents=True, exist_ok=True)
+    tasks = load_tasks(config)
+    atomic_json(directory / "report_context.json", {
+        "config": config, "tasks": [asdict(t) for t in tasks],
+        "isabelle_version": subprocess.check_output(["isabelle", "version"], text=True).strip(),
+        "git_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()})
+    (directory / "results.jsonl").touch(exist_ok=True)
+    atomic_json(directory / "status.json", {
+        "status": reason, "written": 0, "completed": len(read_rows(directory / "results.jsonl")),
+        "planned": len(tasks)*len(config["conditions"]),
+        "usd_reserved_or_spent": config.get("prior_usd_cost", 0)})
+
+
+def generate(directory: Path) -> str:
+    own = read_rows(directory / "results.jsonl")
+    manifest_path = directory / "manifest.json"
+    if not manifest_path.exists():
+        manifest_path = directory / "report_context.json"
+    manifest = json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
+    config = manifest.get("config", {})
+    tasks = manifest.get("tasks", [])
+    wanted = {t["id"] for t in tasks}
+    baseline_path = directory.parent / "tactics" / "results.jsonl"
+    baseline = [] if directory.name == "tactics" else read_rows(baseline_path)
+    if wanted:
+        baseline = [r for r in baseline if r["lemma_id"] in wanted]
+    # Test fakes are never evidence of real-model performance.
+    excluded = sum(r.get("provider") == "fake" for r in own)
+    rows = [r for r in own + baseline if r.get("provider") != "fake"]
+    groups: dict[tuple, list[dict]] = defaultdict(list)
+    for r in rows:
+        groups[(r["condition"]["model"], r["condition"]["max_attempts"], r["stratum"])].append(r)
+    planned = Counter(t["stratum"] for t in tasks)
+    for condition in config.get("conditions", []):
+        if condition["provider"] != "fake":
+            for stratum in planned:
+                groups.setdefault((condition["model"], condition["max_attempts"], stratum), [])
+    ordered = sorted(groups, key=lambda k: (k[0] != "tactics", k))
+    out = [f"# Evaluation summary: {directory.name}\n",
+           "Generated by `python -m eval.harness.report " + str(directory) + "`.\n"]
+    if config:
+        out.append(f"Configuration: max_usd={config['max_usd']}, "
+                   f"max_hours={config.get('max_hours', 8)}, workers={config['workers']}, "
+                   f"kernel_timeout_s={config['kernel_timeout_s']}, "
+                   f"max_completion_tokens={config.get('max_completion_tokens', 2048)}. "
+                   "Real requests default to temperature 0; per-condition exceptions, if any, "
+                   "are recorded in the config and request trace.\n")
+    out.append("Loop limits: at most 40 feedback lines and 3000 feedback characters per retry; "
+               "8000 characters each for proof and auxiliary text. The tactic battery allows "
+               "8 methods with a 30-second timeout for each separate check.\n")
+    real = [r for r in own if r.get("provider") not in {"fake", "tactics"}]
+    if not real:
+        out.append("**No completed real-model observations. This is a baseline-only/partial report, "
+                   "not a measurement of LLM proof performance.**\n")
+    status_path = directory / "status.json"
+    if status_path.exists():
+        status = json.loads(status_path.read_text())
+        spent = status["usd_reserved_or_spent"]
+        ledger = directory / "budget.sqlite"
+        if ledger.exists():
+            with sqlite3.connect(ledger) as db:
+                spent = config.get("prior_usd_cost", 0) + db.execute(
+                    "SELECT COALESCE(SUM(usd),0) FROM calls").fetchone()[0]
+        out.append(f"Last recorded run status: `{status['status']}`. Completed rows: {len(own)}/"
+                   f"{status['planned']}. Reserved/spent LLM budget: "
+                   f"${spent:.6f} (includes prior smoke spending and unfinished-call reservations).\n")
+    out.append("Strata are never pooled. Percentages use completed rows; coverage is shown separately. "
+               "Wilson intervals are descriptive, unadjusted 95% intervals; related example steps "
+               "are not independent random samples. Incomplete runs may omit slower or harder tasks; "
+               "their completed-row rates are not full-corpus estimates. Fake-provider rows excluded: "
+               + str(excluded) + ".\n")
+    out.append("## Table 1 — kernel-accepted proofs\n")
+    counts = []
+    for model, attempts, stratum in ordered:
+        group = groups[model, attempts, stratum]
+        n, successes = len(group), sum(r["proved"] for r in group)
+        ci = wilson(successes, n)
+        counts.append([model, attempts, stratum, f"{n}/{planned.get(stratum, n)}",
+                       proportion(group), f"{100*ci[0]:.1f}–{100*ci[1]:.1f}%" if ci else "NA"])
+    out.append(table(["Model", "Max attempts", "Stratum", "Completed/planned", "Proved", "Wilson 95% CI"], counts))
+    out.append("## Table 2 — value over tactics\n")
+    battery = {r["lemma_id"]: r["proved"] for r in rows if r["condition"]["model"] == "tactics"}
+    comparisons = []
+    for key in ordered:
+        if key[0] == "tactics":
+            continue
+        paired = [r for r in groups[key] if r["lemma_id"] in battery]
+        comparisons.append([*key, len(paired),
+                            sum(r["proved"] and not battery[r["lemma_id"]] for r in paired),
+                            sum(not r["proved"] and battery[r["lemma_id"]] for r in paired)])
+    out.append(table(["Model", "Max attempts", "Stratum", "Paired completed",
+                      "Model only", "Tactics only"], comparisons))
+    if not comparisons:
+        out.append("NA: no completed real-model comparison is available.\n")
+    out.append("## Table 3 — failed attempts by class\n")
+    failures = []
+    for key in ordered:
+        counter = Counter()
+        for row in groups[key]:
+            counter.update(row["attempt_failures"])
+        total = sum(counter.values())
+        failures.append([*key, *[counter[f] for f in FAILURES], total,
+                         f"{counter['unknown_fact']}/{total} ({100*counter['unknown_fact']/total:.1f}%)"
+                         if total else "NA (no failed attempts)"])
+    out.append(table(["Model", "Max attempts", "Stratum", *FAILURES, "Failed attempts",
+                      "Hallucinated-fact rate"], failures))
+    out.append("The requested hallucinated-fact proxy is **unknown_fact / failed attempts**, "
+               "including unsuccessful retries before an eventual proof. This classifier also "
+               "covers unknown types/undeclared names; it does not establish hallucination causally.\n")
+    out.append("## Table 4 — original-proof length\n")
+    out.append(table(["Model", "Max attempts", "Stratum", "1 line", "2–3 lines", "4–8 lines", "9+ lines"],
+                     [[*key, *[proportion([r for r in groups[key] if bucket(r["orig_proof_lines"]) == b])
+                               for b in ["1", "2–3", "4–8", "9+"]]] for key in ordered]))
+    out.append("## Table 5 — cost and elapsed time\n")
+    costs = []
+    for key in ordered:
+        group = groups[key]
+        successes = sum(r["proved"] for r in group)
+        cost = sum(r["usd_cost"] for r in group)
+        gpu = sum(r["gpu_hours"] for r in group) if group and all(
+            r.get("gpu_hours") is not None for r in group) else None
+        bound = " (upper bound)" if any(r["cost_is_upper_bound"] for r in group) else ""
+        median = lambda field: f"{statistics.median(r[field] for r in group):.3f}" if group else "NA"
+        costs.append([*key, f"${cost:.6f}" + bound,
+                      f"${cost/successes:.6f}" + bound if successes else "NA",
+                      f"{gpu/successes:.6f}" if gpu is not None and successes else "NA",
+                      median("llm_wall_s"), median("kernel_wall_s")])
+    out.append(table(["Model", "Max attempts", "Stratum", "Row USD", "USD/proved", "GPU-h/proved",
+                      "Median LLM s/lemma", "Median kernel s/lemma"], costs))
+    out.append("Times are sums across attempts per completed lemma, then medians across lemmas. "
+               "USD values are token-cost estimates at configured prices, not invoices; local CPU "
+               "and engineering costs are excluded. "
+               "Row cost excludes unfinished rows; the run budget above includes reservations. "
+               "GPU time is NA unless measured allocation hours are recorded; LLM latency is not "
+               "silently presented as GPU usage. A zero USD price alone does not imply free compute.\n")
+    out.append("## Methods in accepted proofs\n")
+    methods = "simp auto blast metis fastforce force arith linarith induction try0 other".split()
+    method_rows = []
+    for key in ordered:
+        counter = Counter()
+        for row in groups[key]:
+            if row["proved"]:
+                counter.update(row["methods_used"])
+        method_rows.append([*key, *[counter[m] for m in methods]])
+    out.append(table(["Model", "Max attempts", "Stratum", *methods], method_rows))
+    out.append("Method counts are lexical occurrences in the final accepted proof and auxiliaries; "
+               "`induct` is grouped with `induction`. They are not kernel execution counts. "
+               "The battery uses the literal requested methods without a `using assms` preface; "
+               "statements with named assumptions may therefore be disadvantaged. "
+               "These rates measure this fixed battery, not mathematical difficulty alone.\n")
+    out.append("## Provenance and limitations\n")
+    provenance = []
+    for key in ordered:
+        group = groups[key]
+        provenance.append([*key, ", ".join(sorted({i for r in group for i in r["model_ids_returned"]})) or "NA",
+                           ", ".join(sorted({r["isabelle_version"] for r in group})) or "NA",
+                           ", ".join(sorted({r["git_sha"] for r in group})) or "NA"])
+    out.append(table(["Model", "Max attempts", "Stratum", "Returned API model ids",
+                      "Isabelle", "Git SHA"], provenance))
+    out.append("`lib` statements and proofs are public distribution material and may be in model "
+               "training data. Imported Main/Complex_Main also retain original facts and simp rules: "
+               "this is reconstruction in that environment. The `fresh` label currently means "
+               "repository example-derived steps, with no verified training-data novelty. "
+               "No hand-written fresh_statements.thy was supplied. Corpus filtering favours statements "
+               "and original proofs that validate within the documented selection bounds. "
+               "These limitations preclude a contamination-free generalization claim.\n")
+    return "\n".join(out)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("directory")
+    parser.add_argument("--config", help="Describe a partial run without launching it")
+    args = parser.parse_args()
+    directory = report_directory(args.directory)
+    directory.mkdir(parents=True, exist_ok=True)
+    if args.config:
+        prepare_partial(directory, json.loads(Path(args.config).read_text()), "real_models_unavailable")
+    output = generate(directory)
+    (directory / "summary.md").write_text(output)
+    print(output, end="")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/harness/runner.py b/eval/harness/runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..e40e01533e03d0e63659dfd601f27309cd2d3db0
--- /dev/null
+++ b/eval/harness/runner.py
@@ -0,0 +1,189 @@
+"""Bounded process-pool orchestration. Only the parent appends result rows."""
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import FIRST_COMPLETED, ProcessPoolExecutor, wait
+from dataclasses import asdict
+import fcntl
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import subprocess
+
+from .agent import atomic_json, run_task
+from .budget import Budget, BudgetStop, available_usd
+from .schema import Result, Task, key
+
+
+def load_tasks(config: dict) -> list[Task]:
+    tasks = [Task.from_row(json.loads(line)) for path in config["corpus"]
+             for line in Path(path).read_text().splitlines() if line.strip()]
+    if "lemma_ids" in config:
+        wanted = set(config["lemma_ids"])
+        tasks = [t for t in tasks if t.id in wanted]
+        if {t.id for t in tasks} != wanted:
+            raise ValueError("Unknown configured lemma id")
+    if "lib_limit" in config:
+        lib = sorted((t for t in tasks if t.stratum == "lib"), key=lambda t: t.id)
+        keep = {t.id for t in lib[:config["lib_limit"]]}
+        tasks = [t for t in tasks if t.stratum != "lib" or t.id in keep]
+    if len({t.id for t in tasks}) != len(tasks):
+        raise ValueError("Duplicate lemma ids")
+    for t in tasks:
+        if not re.fullmatch(r"[A-Za-z0-9_./'-]+", t.id) or ".." in Path(t.id).parts or t.id.startswith("/"):
+            raise ValueError("Unsafe lemma id")
+    return tasks
+
+
+def read_rows(path: Path) -> list[dict]:
+    if not path.exists():
+        return []
+    rows = []
+    for line in path.read_text().splitlines():
+        if line.strip():
+            row = json.loads(line)
+            Result(**row).validate()
+            rows.append(row)
+    if len({key(r) for r in rows}) != len(rows):
+        raise ValueError("Duplicate result keys")
+    return rows
+
+
+def validate_config(config: dict) -> None:
+    if not re.fullmatch(r"[A-Za-z0-9_-]+", config["run_id"]):
+        raise ValueError("Unsafe run id")
+    for name in ("max_usd", "max_hours"):
+        value = config.get(name, 8 if name == "max_hours" else -1)
+        if not math.isfinite(value) or value < 0:
+            raise ValueError(f"Invalid {name}")
+    if config["workers"] < 1 or config["kernel_timeout_s"] <= 0:
+        raise ValueError("Workers and kernel timeout must be positive")
+    prior = config.get("prior_usd_cost", 0)
+    if not math.isfinite(prior) or not 0 <= prior <= config["max_usd"]:
+        raise ValueError("Prior smoke spending exceeds the fixed ceiling")
+    seen = set()
+    for condition in config["conditions"]:
+        identity = (condition["model"], condition["max_attempts"])
+        if identity in seen or condition["max_attempts"] < 1:
+            raise ValueError("Duplicate or invalid condition")
+        seen.add(identity)
+        if condition["provider"] not in {"fake", "tactics", "openai_compatible", "anthropic"}:
+            raise ValueError("Unknown provider")
+        if condition["provider"] not in {"fake", "tactics"}:
+            rates = config["cost_usd_per_m"][condition["model"]]
+            if any(not math.isfinite(rates[k]) or rates[k] < 0 for k in ("prompt", "completion")):
+                raise ValueError("Missing/invalid explicit model pricing")
+
+
+def execute(task: Task, condition: dict, config: dict, metadata: dict,
+            offset: int, root: Path, keep_work: bool) -> dict | None:
+    try:
+        if condition["provider"] == "tactics":
+            from .tactics import run_tactics
+            return run_tactics(task, condition, config, metadata, offset, root, keep_work)
+        return run_task(task, condition, config, metadata, offset, root, keep_work)
+    except BudgetStop as exc:
+        atomic_json(root / config["run_id"] / "stopped" / task.id / f"condition_{offset}.json",
+                    {"reason": str(exc), "condition": condition})
+        return None
+
+
+def run(config: dict, root: Path = Path("eval/results"), keep_work: bool = False) -> dict:
+    validate_config(config)
+    tasks = load_tasks(config)
+    directory = root / config["run_id"]
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / "run.lock").open("w") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        metadata = {
+            "isabelle_version": subprocess.check_output(["isabelle", "version"], text=True).strip(),
+            "git_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()}
+        fingerprint = hashlib.sha256(json.dumps(
+            [config, [asdict(t) for t in tasks]], sort_keys=True).encode()).hexdigest()
+        manifest_path = directory / "manifest.json"
+        if manifest_path.exists():
+            if json.loads(manifest_path.read_text())["fingerprint"] != fingerprint:
+                raise ValueError("Config/corpus changed; use a new run_id")
+        else:
+            atomic_json(manifest_path, {"config": config, "fingerprint": fingerprint,
+                                       "tasks": [asdict(t) for t in tasks], **metadata})
+        path = directory / "results.jsonl"
+        # Preserve an incomplete append, then recover only the unterminated tail.
+        if path.exists() and path.read_bytes() and not path.read_bytes().endswith(b"\n"):
+            data = path.read_bytes()
+            tail = data.rsplit(b"\n", 1)[-1]
+            (directory / "interrupted_tail.json").write_bytes(tail)
+            path.write_bytes(data[:len(data)-len(tail)])
+        rows = read_rows(path)
+        if rows and not (directory / "budget.sqlite").exists():
+            raise ValueError("Spend ledger missing for existing rows; refusing a fresh budget")
+        completed = {key(r) for r in rows}
+        jobs, offset = [], 0
+        for condition in config["conditions"]:
+            for task in tasks:
+                identity = (config["run_id"], task.id, condition["model"], condition["max_attempts"])
+                if identity not in completed:
+                    jobs.append((task, condition, config, metadata, offset, root, keep_work))
+            offset += condition["max_attempts"]
+        budget = Budget(directory / "budget.sqlite", available_usd(config), config.get("max_hours", 8))
+        atomic_json(directory / "status.json", {
+            "status": "running", "written": 0, "completed": len(rows),
+            "planned": len(tasks)*len(config["conditions"]),
+            "usd_reserved_or_spent": config.get("prior_usd_cost", 0) + budget.total(), **metadata})
+        pending, iterator, written, stopped = {}, iter(jobs), 0, False
+        with ProcessPoolExecutor(max_workers=config["workers"]) as pool, path.open("a") as out:
+            def submit_one() -> bool:
+                nonlocal stopped
+                if budget.remaining_s() <= 0:
+                    stopped = True
+                    return False
+                job = next(iterator, None)
+                if job is None:
+                    return False
+                pending[pool.submit(execute, *job)] = job[0].id
+                return True
+            for _ in range(config["workers"]):
+                if not submit_one():
+                    break
+            while pending:
+                ready, _ = wait(pending, return_when=FIRST_COMPLETED)
+                for future in ready:
+                    pending.pop(future)
+                    row = future.result()
+                    if row is None:
+                        stopped = True
+                    else:
+                        out.write(json.dumps(row, ensure_ascii=False) + "\n")
+                        out.flush()
+                        os.fsync(out.fileno())
+                        written += 1
+                        print(row["lemma_id"], json.dumps(row["condition"], separators=(",", ":")),
+                              row["proved"], row["attempts_used"], row["failure_class"],
+                              f'{row["usd_cost"]:.6f}', flush=True)
+                    if not stopped:
+                        submit_one()
+        status = {"status": "no_conditions" if not config["conditions"] else
+                  "budget_or_interrupted_call" if stopped else "complete",
+                  "written": written, "completed": len(rows) + written,
+                  "planned": len(tasks)*len(config["conditions"]),
+                  "usd_reserved_or_spent": config.get("prior_usd_cost", 0) + budget.total(),
+                  **metadata}
+        atomic_json(directory / "status.json", status)
+        return status
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("config")
+    parser.add_argument("--keep-work", action="store_true")
+    args = parser.parse_args()
+    status = run(json.loads(Path(args.config).read_text()), keep_work=args.keep_work)
+    if status["status"] == "no_conditions":
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/harness/scanner.py b/eval/harness/scanner.py
new file mode 100644
index 0000000000000000000000000000000000000000..026f04fee753ed907e4660b1575160eecaa295a5
--- /dev/null
+++ b/eval/harness/scanner.py
@@ -0,0 +1,96 @@
+"""Conservative lexical rejection, including forbidden words in comments.
+
+This is a defence in addition to quick_and_dirty=false, not an Isar parser.
+False positives are preferable to executing model-supplied ML or declarations.
+"""
+from __future__ import annotations
+
+import re
+
+FORBIDDEN = set("""sorry oops axiomatization quick_and_dirty skip_proof cheat
+ML ML_prf ML_val setup declare consts defs overloading code_printing theory
+imports begin lemmas translations notation no_notation hide_fact hide_const
+sledgehammer nitpick try oracle axioms tactic raw_tactic method_setup attribute_setup
+local_setup ML_file ML_command simproc_setup syntax no_syntax abbreviation
+definition typedef type_synonym locale class instantiation interpretation
+sublocale bundle unbundle external_file SML SML_file""".lower().split())
+WORD = re.compile(r"(?<![\w'])[A-Za-z_][\w']*")
+
+
+def balanced(text: str) -> bool:
+    """No lexical construct may cross the harness-owned statement boundary."""
+    stack: list[str] = []
+    i = 0
+    while i < len(text):
+        top = stack[-1] if stack else ""
+        if top == '"':
+            if text[i:i+2] in {'\\"', '\\\\'}:
+                i += 2
+                continue
+            if text[i] == '"':
+                stack.pop()
+        elif top == "(*":
+            if text.startswith("(*", i):
+                stack.append("(*")
+                i += 2
+                continue
+            if text.startswith("*)", i):
+                stack.pop()
+                i += 2
+                continue
+        else:
+            found = False
+            for opening, closing in (("‹", "›"), (r"\<open>", r"\<close>"), ("(*", "*)")):
+                if text.startswith(opening, i):
+                    stack.append(opening)
+                    i += len(opening)
+                    found = True
+                    break
+                if text.startswith(closing, i):
+                    if top != opening:
+                        return False
+                    stack.pop()
+                    i += len(closing)
+                    found = True
+                    break
+            if found:
+                continue
+            if text[i] == '"' and not stack:
+                stack.append('"')
+        i += 1
+    return not stack
+
+
+def scan(proof_text: str, aux_lemmas: str = "", target: str = "") -> list[str]:
+    from eval.corpus.build_corpus import lex
+    reasons = []
+    for label, text in (("proof", proof_text), ("aux", aux_lemmas)):
+        if len(text) > 8000:
+            reasons.append(f"{label} exceeds 8000 characters")
+        if not balanced(text):
+            reasons.append(f"{label}: unbalanced lexical construct")
+        for token in WORD.findall(text):
+            if token.lower() in FORBIDDEN or token.lower().startswith(("cheat_", "skip_proof")):
+                reasons.append(f"{label}: forbidden token {token}")
+        try:
+            if any(token.value == "end" for token in lex(text)):
+                reasons.append(f"{label}: forbidden command end")
+        except ValueError:
+            reasons.append(f"{label}: malformed lexical construct")
+        # Reject control characters and symbol-encoded keyword obfuscation.
+        if any(ord(ch) < 32 and ch not in "\n\r\t" for ch in text):
+            reasons.append(f"{label}: control character")
+    try:
+        header = False
+        for token in lex(aux_lemmas):
+            if token.value in {"lemma", "theorem", "corollary"}:
+                header = True
+            elif token.value == ":":
+                header = False
+            elif header and target:
+                name = token.value.strip('"‹›').removeprefix(r"\<open>").removesuffix(r"\<close>")
+                if name.rsplit(".", 1)[-1] == target:
+                    reasons.append("auxiliary lemma shadows target")
+    except ValueError:
+        pass  # Already rejected by the per-fragment lexical check.
+    return sorted(set(reasons))
diff --git a/eval/harness/schema.py b/eval/harness/schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..394e7a8b9232ac3031a556e89cb071b8ab226a79
--- /dev/null
+++ b/eval/harness/schema.py
@@ -0,0 +1,74 @@
+"""Public task boundary and validated result records."""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import math
+from .classify import FAILURES
+
+
+@dataclass(frozen=True)
+class Task:
+    id: str
+    stratum: str
+    imports: list[str]
+    statement: str
+    orig_proof_lines: int
+
+    @classmethod
+    def from_row(cls, row: dict) -> Task:
+        # Deliberate allowlist: private corpus fields cannot enter the agent.
+        return cls(**{name: row[name] for name in cls.__dataclass_fields__})
+
+
+@dataclass
+class Result:
+    run_id: str
+    lemma_id: str
+    stratum: str
+    condition: dict
+    proved: bool
+    attempts_used: int
+    failure_class: str | None
+    final_error: str
+    proof_text: str
+    proof_lines: int
+    methods_used: dict[str, int]
+    aux_lemmas: str
+    prompt_tokens: int
+    completion_tokens: int
+    usd_cost: float
+    llm_wall_s: float
+    kernel_wall_s: float
+    model_id_returned: str | None
+    isabelle_version: str
+    git_sha: str
+    timestamp: str
+    # Needed to reproduce attempt-level rates and difficulty curves from rows.
+    orig_proof_lines: int
+    attempt_failures: dict[str, int]
+    model_ids_returned: list[str]
+    cost_is_upper_bound: bool = False
+    provider: str = ""
+    gpu_hours: float | None = None
+
+    def validate(self) -> None:
+        assert type(self.proved) is bool
+        assert self.failure_class is None if self.proved else self.failure_class in FAILURES
+        assert 1 <= self.attempts_used <= self.condition["max_attempts"]
+        assert len(self.final_error) <= 500
+        assert self.proof_lines == len(self.proof_text.splitlines())
+        for number in (self.usd_cost, self.llm_wall_s, self.kernel_wall_s):
+            assert math.isfinite(number) and number >= 0
+        assert self.prompt_tokens >= 0 and self.completion_tokens >= 0
+        assert set(self.attempt_failures) <= set(FAILURES)
+        assert sum(self.attempt_failures.values()) == self.attempts_used - int(self.proved)
+        assert self.isabelle_version and len(self.git_sha) == 40
+
+    def to_dict(self) -> dict:
+        self.validate()
+        return asdict(self)
+
+
+def key(row: dict) -> tuple[str, str, str, int]:
+    return (row["run_id"], row["lemma_id"], row["condition"]["model"],
+            row["condition"]["max_attempts"])
diff --git a/eval/harness/smoke.py b/eval/harness/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..922edd7affe48c82249820e6e2865a4d80e81211
--- /dev/null
+++ b/eval/harness/smoke.py
@@ -0,0 +1,222 @@
+"""Ten-lemma smoke, conservative projection, and the prescribed shrinking order."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import copy
+import json
+from pathlib import Path
+import random
+import statistics
+import sys
+
+from .agent import atomic_json
+from .budget import Budget
+from .runner import load_tasks, read_rows, run
+
+
+def make_smoke(full: dict) -> dict:
+    config = copy.deepcopy(full)
+    config["run_id"] = full.get("smoke_run_id", "smoke")
+    config["prior_run_costs"] = {
+        name: value for name, value in full.get("prior_run_costs", {}).items()
+        if name != config["run_id"]}
+    seen = set()
+    conditions = []
+    for condition in full["conditions"]:
+        if condition["model"] not in seen:
+            seen.add(condition["model"])
+            conditions.append({**condition, "max_attempts": 1})
+    config["conditions"] = conditions
+    config["prior_usd_cost"] = sum(config["prior_run_costs"].values())
+    rng = random.Random(20251020)
+    tasks = load_tasks(full)
+    ids = []
+    for stratum in ("lib", "fresh"):
+        candidates = sorted(t.id for t in tasks if t.stratum == stratum)
+        if len(candidates) < 5:
+            raise ValueError(f"Smoke needs five {stratum} lemmas")
+        ids.extend(rng.sample(candidates, 5))
+    config["lemma_ids"] = ids
+    return config
+
+
+def sample_statistics(rows: list[dict]) -> dict[str, dict]:
+    result = {}
+    for model in sorted({r["condition"]["model"] for r in rows}):
+        group = [r for r in rows if r["condition"]["model"] == model]
+        # Do not let authentication failures make a functioning provider look cheap.
+        usable = [r for r in group if r["failure_class"] != "provider_error"]
+        if usable:
+            result[model] = {
+                "prompt": statistics.mean(r["prompt_tokens"] for r in usable),
+                "completion": statistics.mean(r["completion_tokens"] for r in usable),
+                "llm_s": statistics.mean(r["llm_wall_s"] for r in usable)}
+    return result
+
+
+def project(config: dict, counts: dict[str, int], samples: dict[str, dict],
+            kernel_median_s: float) -> dict:
+    n = min(counts.get("lib", 0), config.get("lib_limit", counts.get("lib", 0)))
+    n += sum(value for name, value in counts.items() if name != "lib")
+    cost, kernel_s, llm_s = 0., 0., 0.
+    details = []
+    for condition in config["conditions"]:
+        model, k = condition["model"], condition["max_attempts"]
+        if model not in samples:
+            raise ValueError(f"No usable smoke measurements for {model}")
+        sample, rate = samples[model], config["cost_usd_per_m"][model]
+        # Worst-case attempt counts, plus explicit retry-context growth allowance.
+        prompt = sample["prompt"]*k + (sample["completion"] + 3000)*k*(k-1)/2
+        output = sample["completion"]*k
+        amount = n * (prompt*rate["prompt"] + output*rate["completion"]) / 1e6
+        cost += amount
+        kernel_s += n*k*kernel_median_s
+        llm_s += n*k*sample["llm_s"]
+        details.append({"model": model, "max_attempts": k, "lemmas": n, "usd": amount})
+    prior = config.get("prior_usd_cost", 0)
+    return {"conditions": details, "lemmas": n, "prior_usd_cost": prior,
+            "projected_llm_usd": cost, "projected_total_usd": prior+cost,
+            "kernel_hours": kernel_s/config["workers"]/3600,
+            "projected_hours": 1.25*(kernel_s+llm_s)/config["workers"]/3600}
+
+
+def shrink(config: dict, counts: dict[str, int], samples: dict[str, dict],
+           median_s: float) -> tuple[dict, dict, list[str]]:
+    config = copy.deepcopy(config)
+    dropped = []
+    def fits() -> bool:
+        estimate = project(config, counts, samples, median_s)
+        return (estimate["projected_total_usd"] <= config["max_usd"]
+                and estimate["projected_hours"] <= config["max_hours"])
+    if not fits():
+        removed = [c for c in config["conditions"] if c["max_attempts"] == 4]
+        config["conditions"] = [c for c in config["conditions"] if c["max_attempts"] != 4]
+        if removed:
+            dropped.append("Dropped all max_attempts=4 conditions")
+    models = list(dict.fromkeys(c["model"] for c in config["conditions"]))
+    while not fits() and len(models) > 1:
+        model = models.pop(0)
+        config["conditions"] = [c for c in config["conditions"] if c["model"] != model]
+        dropped.append(f"Dropped model in config order: {model}")
+    if not fits() and counts.get("lib", 0) > 150:
+        config["lib_limit"] = min(config.get("lib_limit", counts["lib"]), 150)
+        dropped.append("Subsampled lib to 150 sorted lemma ids")
+    if not fits():
+        dropped.append("No remaining condition fits; dropped the final model")
+        config["conditions"] = []
+    return config, project(config, counts, samples, median_s), dropped
+
+
+def prepare_and_gate(path: Path) -> tuple[dict, bool]:
+    full = json.loads(path.read_text())
+    observations = json.loads(Path("eval/results/m0/observations.json").read_text())
+    median = observations["trivial_median_s"]
+    smoke = make_smoke(full)
+    atomic_json(Path("eval/configs/smoke.json"), smoke)
+    directory = Path("eval/results") / smoke["run_id"]
+    directory.mkdir(parents=True, exist_ok=True)
+    errors, status = [], None
+    # A failed check is bounded to three attempts; no unattended question waits.
+    for attempt in range(1, 4):
+        try:
+            if not smoke["conditions"]:
+                raise ValueError("No configured models for the real-provider smoke run")
+            status = run(smoke)
+            if status["status"] != "complete" or status["completed"] != status["planned"]:
+                raise RuntimeError("Smoke incomplete: " + status["status"])
+            break
+        except Exception as exc:
+            message = f"check {attempt}: {type(exc).__name__}: {exc}"
+            errors.append(message)
+            atomic_json(directory / f"check_{attempt}.json", {"error": message})
+            print(message, file=sys.stderr)
+    rows = read_rows(directory / "results.jsonl")
+    prior_runs = dict(full.get("prior_run_costs", {}))
+    ledger = directory / "budget.sqlite"
+    if ledger.exists():
+        prior_runs[smoke["run_id"]] = Budget(ledger, smoke["max_usd"], smoke["max_hours"]).total()
+    full["prior_run_costs"] = prior_runs
+    full["prior_usd_cost"] = sum(prior_runs.values())
+    dropped = []
+    for model in dict.fromkeys(c["model"] for c in full["conditions"]):
+        group = [r for r in rows if r["condition"]["model"] == model]
+        if len(group) == 10 and all(r["failure_class"] == "provider_error" for r in group):
+            full["conditions"] = [c for c in full["conditions"] if c["model"] != model]
+            dropped.append(f"Dropped {model}: provider_error on all 10 smoke lemmas")
+    counts = dict(Counter(t.stratum for t in load_tasks(full)))
+    samples = sample_statistics(rows)
+    checked = status is not None and status["status"] == "complete"
+    before = project(full, counts, samples, median) if not full["conditions"] or checked else None
+    if before is not None:
+        full, projection, shrinking = shrink(full, counts, samples, median)
+        dropped += shrinking
+    else:
+        projection = None
+    usable = checked and bool(full["conditions"]) and projection is not None
+    if usable:
+        usable = (projection["projected_total_usd"] <= full["max_usd"]
+                  and projection["projected_hours"] <= full["max_hours"])
+    atomic_json(path, full)
+    decision = {"smoke_complete": checked, "proceed_to_full": usable, "errors": errors,
+                "dropped": dropped, "before_shrinking": before, "projection": projection,
+                "max_usd": full["max_usd"], "max_hours": full["max_hours"],
+                "kernel_median_s": median, "samples": samples}
+    atomic_json(directory / "projection.json", decision)
+    notes = Path("docs/EVAL_NOTES.md")
+    with notes.open("a") as out:
+        out.write("\n## M5: smoke checks and budget gate\n\n")
+        out.write("- **What happened.** " + ("Smoke completed." if checked else
+                  "Smoke acceptance failed three consecutive checks; no real-model smoke was established.") + "\n")
+        out.write("- **Experience.** Missing models/credentials are unavailable measurements, not failed proofs or zero-cost model evidence.\n")
+        out.write("- **Fix / action.** " + ("Proceed to M6 automatically within the fixed limits." if usable else
+                  "Stop the real-model phase and produce the required partial report from existing data.") + "\n\n")
+        out.write("Projection uses all allowed attempts, smoke mean token/latency measurements, "
+                  "3000 additional feedback tokens per retry plus preceding completions, "
+                  "and a 25% wall-time margin. Kernel hours use the M0 median × attempts / workers. "
+                  "An empty schedule projects zero scheduled work; it is not a model estimate.\n\n")
+        out.write("```json\n" + json.dumps(decision, indent=2) + "\n```\n")
+    return full, usable
+
+
+def run_full_with_restarts(config: dict) -> dict:
+    failures = []
+    for restart in range(4):  # Initial execution plus at most three restarts.
+        try:
+            return run(config)
+        except Exception as exc:
+            message = f"Full run restart {restart}: {type(exc).__name__}: {exc}"
+            failures.append(message)
+            print(message, file=sys.stderr)
+            if restart == 3:
+                with Path("docs/EVAL_NOTES.md").open("a") as out:
+                    out.write("\n## M6: exhausted process restarts\n\n"
+                              "- **What happened.** The initial process and three restarts failed.\n"
+                              "- **Experience.** Some rows may be incomplete.\n"
+                              "- **Fix / action.** Retain all receipts and generate the partial report.\n\n"
+                              + "```text\n" + "\n".join(failures) + "\n```\n")
+                raise
+    raise AssertionError("Unreachable")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="eval/configs/full.json")
+    parser.add_argument("--run-full", action="store_true")
+    args = parser.parse_args()
+    config, usable = prepare_and_gate(Path(args.config))
+    if args.run_full:
+        from .report import generate, prepare_partial
+        directory = Path("eval/results") / config["run_id"]
+        try:
+            if usable:
+                run_full_with_restarts(config)
+        finally:
+            prepare_partial(directory, config, "real_models_unavailable")
+            (directory / "summary.md").write_text(generate(directory))
+    if not usable:
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/harness/tactics.py b/eval/harness/tactics.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b74df45f94d3f154d6c79c59e09b5c848e58b9d
--- /dev/null
+++ b/eval/harness/tactics.py
@@ -0,0 +1,69 @@
+"""The fixed, ordered no-LLM tactic battery."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .agent import assess, atomic_json, summarize
+from .budget import Budget, BudgetStop
+from .schema import Task
+
+TACTICS = ["by simp", "by auto", "by blast", "by fastforce", "by force",
+           "by linarith", "by arith", "by (simp add: algebra_simps)"]
+
+
+def run_tactics(task: Task, condition: dict, config: dict, metadata: dict,
+                offset: int, root: Path, keep_work: bool = False) -> dict:
+    if condition["max_attempts"] != 8:
+        raise ValueError("The tactic baseline is exactly eight ordered methods")
+    budget = Budget(root / config["run_id"] / "budget.sqlite", 0, config.get("max_hours", 8))
+    records = []
+    for attempt, proof in enumerate(TACTICS, 1):
+        path = root / config["run_id"] / "kernel_attempts" / task.id / f"attempt_{attempt}.json"
+        if path.exists():
+            record = json.loads(path.read_text())
+        else:
+            remaining = budget.remaining_s()
+            if remaining <= 0:
+                raise BudgetStop("tactic run wall-clock limit")
+            outcome = assess(task, proof, "", config["run_id"], offset+attempt,
+                             root, min(30, remaining), keep_work)
+            record = {"result": outcome, "tactic": proof, "attempt": attempt,
+                      "usd_cost": 0, **metadata}
+            atomic_json(path, record)
+        records.append(record)
+        if record["result"]["proved"]:
+            break
+    return summarize(task, condition, config["run_id"], records, metadata)
+
+
+def update_corpus(paths: list[str], rows: list[dict]) -> None:
+    outcomes = {r["lemma_id"]: r["proved"] for r in rows
+                if r["condition"] == {"model": "tactics", "max_attempts": 8}}
+    for path_string in paths:
+        path = Path(path_string)
+        corpus = [json.loads(line) for line in path.read_text().splitlines()]
+        for row in corpus:
+            row["tactic_baseline_proved"] = outcomes.get(row["id"])
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text("".join(json.dumps(row, ensure_ascii=False)+"\n" for row in corpus))
+        temporary.replace(path)
+
+
+def main() -> None:
+    from .runner import read_rows, run
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="eval/configs/tactics.json")
+    parser.add_argument("--keep-work", action="store_true")
+    args = parser.parse_args()
+    config = json.loads(Path(args.config).read_text())
+    status = run(config, keep_work=args.keep_work)
+    rows = read_rows(Path("eval/results") / config["run_id"] / "results.jsonl")
+    update_corpus(config["corpus"], rows)
+    if status["completed"] != status["planned"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/harness/writeup.py b/eval/harness/writeup.py
new file mode 100644
index 0000000000000000000000000000000000000000..1f442bae310182fc6b6588efd6c3d10274dc3a70
--- /dev/null
+++ b/eval/harness/writeup.py
@@ -0,0 +1,218 @@
+"""Generate the method/results skeleton; preserve human interpretation separately."""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from .agent import SYSTEM_PROMPT
+from .report import report_directory
+
+BEGIN = "<!-- BEGIN GENERATED SUMMARY -->"
+END = "<!-- END GENERATED SUMMARY -->"
+
+
+def generate(summary: str) -> str:
+    body = summary.partition("\n\n")[2]
+    partial = "No completed real-model observations." in summary
+    status = (
+        "The current measurements are the completed no-LLM tactic baseline. "
+        "The real-model smoke and full phases were unavailable because models "
+        "and provider credentials were not configured. No real-model performance "
+        "or value over tactics is claimed."
+        if partial else
+        "The completed observations and coverage are shown in the generated "
+        "tables below. Incomplete coverage must not be interpreted as a "
+        "full-corpus success rate."
+    )
+    return f"""# Headless proof evaluation — write-up skeleton
+
+## Abstract
+
+TODO(Leo)
+
+## Research question
+
+TODO(Leo)
+
+The operational question is how often proposed proof text passes the Isabelle
+kernel under a fixed statement and import context. A model's assertion that it
+has proved something is never a success criterion.
+
+## Measurement status
+
+{status}
+No contamination-free generalization result is claimed. Fake providers are
+test fixtures and are excluded from the tables.
+
+## Corpus and contamination
+
+`lib` comes from the installed Isabelle distribution. The builder walks HOL and
+Library source theories, extracts named top-level lemma/theorem/corollary
+declarations outside local blocks, strips name attributes, and retains
+source-file/line provenance. It validates the statement with an admission in
+explicit quick-and-dirty mode, then validates the original proof with that mode
+disabled. Source selection is sorted and seeded, with a per-source cap.
+Existing complete corpus snapshots are retained on ordinary revalidation;
+`--rebuild` explicitly changes the dataset. Selection timeouts can affect
+eligibility across machines.
+
+Treat the library stratum as potentially contaminated: its statements and
+proofs are public training material. Main/Complex_Main also retain original
+facts and simplification rules, so library reconstruction happens in that
+imported environment.
+
+`fresh` currently contains validated steps derived from Swarm, Cascade, Sqrt2
+and Sqrt4 in this repository. Local dependencies become named assumptions and
+local abbreviations are expanded. Its training-data novelty is unverified;
+no hand-written fresh source was supplied. The strata are reported separately
+throughout, with no pooled success rate. Corpus sizes and proof-length buckets
+appear in the generated tables.
+
+## Exact evaluation method
+
+The agent receives the canonical statement and its imports, never the held-out
+proof. A public-task allowlist enforces that boundary. Distinct private canaries
+and a positive control test check decoded trace strings for leaks; a common
+independently generated proof such as `by simp` is not itself evidence of a leak.
+
+The response must contain a proof block, with an optional preceding auxiliary
+lemma block. The harness scans both fragments, prevents target-name shadowing
+and cross-boundary lexical constructs, and inserts the statement verbatim into
+a fresh theory. Each attempt uses its own temporary directory and headless
+`isabelle process_theories` invocation with `quick_and_dirty=false`.
+
+A result is proved only when the process exits zero, the scan passes, the
+captured kernel output contains no parsed error, the check did not time out,
+and the canonical statement remains verbatim. Timeouts kill the owned process
+tree, including separate Isabelle ML process groups. No kernel, HOL, Isar or
+distribution code is changed; the VS Code/MCP bridge is not used.
+
+On failure, the next turn contains the previous model response and bounded
+kernel/checker feedback. Missing response blocks are parse errors. The loop
+stops at the first accepted proof or its configured attempt limit.
+Sledgehammer, Nitpick and the broader `try` command are rejected; `try0` is
+allowed. The numerical feedback, proof-length, token, timeout and budget limits
+are stated in the generated summary below.
+
+Every harness provider invocation has a durable request trace before the call
+and a full response/usage/latency trace before parsing. Returned model identifiers,
+Isabelle version and execution HEAD are retained. Failed or interrupted calls
+with unknown usage retain a conservative spend reservation; requests without
+a recorded response are not silently repeated. Rows already present for the
+same run, lemma and condition are skipped.
+Trace paths are `eval/results/traces/<run_id>/<lemma_id>/attempt_<n>.json`;
+the ordinal is unique across conditions within a lemma, with the local attempt
+number and condition also recorded inside the trace.
+
+The adapters use environment credentials only. Temperature is zero by default;
+explicit unsupported-temperature exceptions are recorded in request/config
+data. Provider transport was tested with mocked HTTP responses, while proof
+acceptance was tested against real Isabelle. Live provider observations,
+where available, are reported separately from those tests.
+
+The baseline tries the literal methods in this order:
+`simp`, `auto`, `blast`, `fastforce`, `force`, `linarith`, `arith`,
+then `simp add: algebra_simps`. It stops at its first accepted proof.
+It adds no `using assms` preface, induction guess, Metis call, or external
+prover baseline. The fixed method order is part of the measurement.
+
+The budget gate uses smoke token/latency observations and measured kernel
+startup time. It first removes larger attempt budgets, then models in config
+order, then reduces the library sample while retaining the final model where
+possible. Smoke spending shares the fixed USD ceiling. The full runner is
+resumable, checks its persistent budget/deadline, and has bounded process
+restarts. Incomplete coverage and unavailable measurements are reported explicitly.
+
+## Exact system prompt
+
+```text
+{SYSTEM_PROMPT}
+```
+
+The initial user message is exactly:
+
+```text
+imports <space-separated canonical imports>
+
+<canonical statement>
+```
+
+Subsequent user messages begin `Kernel/checker feedback:` and contain the
+bounded error text. The previous response is retained as the preceding
+assistant turn. The held-out proof is used for corpus validation and the
+explicit held-out Fake test policy, never a real-provider prompt.
+
+## Generated measurements
+
+The following content is copied from `eval/results/full/summary.md`.
+Tables derive from the saved result rows. Protocol, coverage and budget
+metadata additionally use the local run context and ledger, where present.
+
+{BEGIN}
+{body.rstrip()}
+{END}
+
+## Interpretation
+
+TODO(Leo)
+
+## Limitations
+
+- Only one prompt style and one default temperature were specified.
+- {"There is no live real-model measurement in this report." if partial else "Model coverage and any incomplete runs are shown in the generated summary."}
+- The library is public and its imported facts remain available; the
+  example-derived stratum has no verified novelty guarantee.
+- Related decomposed steps are dependent observations. Wilson intervals are
+  descriptive and do not correct for that dependence or selection.
+- Kernel timeouts and corpus validation filtering can favour faster tasks.
+- The literal tactic battery is sensitive to fact forwarding and statement
+  syntax. Original proof length is a rough proxy, not a difficulty label.
+- No Sledgehammer/Nitpick runs are included in the agent loop, and the optional
+  external-prover/AFP/persistent-server extensions were not performed.
+- Token costs use configured prices and exclude CPU and engineering costs.
+  Missing GPU-allocation measurements remain unavailable.
+- Milestone commits follow checks. Execution HEADs and local source hashes,
+  including the baseline's pre-milestone HEAD, are explained in EVAL_NOTES.md.
+- Raw rows and private receipts are gitignored as requested. Publishing the
+  summary alone does not constitute a release of the raw evaluation data.
+
+Further interpretation and publication claims: TODO(Leo)
+
+## Reproduce in five commands
+
+Prerequisites: the supported Isabelle installation and Python are available.
+Set provider credentials in environment variables and put explicit model IDs,
+prices and limits in `eval/configs/full.json` before requesting real calls.
+OpenAI-compatible access uses `OPENAI_BASE_URL` and `OPENAI_API_KEY`; Anthropic
+access uses `ANTHROPIC_API_KEY`.
+Use a new run ID when changing a measured configuration or corpus. Re-running
+only the report command regenerates the existing local tables without API calls.
+The unavailable placeholder in this checkout does not reserve the full run ID.
+
+```sh
+python3 -m venv eval/.venv && eval/.venv/bin/python -m pip install -r eval/requirements.txt
+eval/.venv/bin/python -m eval.probe_m0 && eval/.venv/bin/python -m eval.corpus.build_corpus
+eval/.venv/bin/python -m eval.harness.tactics
+eval/.venv/bin/python -m eval.harness.smoke --run-full
+eval/.venv/bin/python -m eval.harness.report results/full && eval/.venv/bin/python -m eval.harness.writeup
+```
+
+In an environment without configured real models, the smoke command records
+the failed checks, writes the partial report, and exits nonzero. Continue with
+the final reporting command to obtain the available baseline-only write-up.
+The generator overwrites the skeleton; keep authored interpretation separately
+or copy it back after regenerating.
+"""
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--results", default="results/full")
+    parser.add_argument("--output", default="docs/EVAL_RESULTS.md")
+    args = parser.parse_args()
+    summary = (report_directory(args.results) / "summary.md").read_text()
+    Path(args.output).write_text(generate(summary))
+
+
+if __name__ == "__main__":
+    main()
