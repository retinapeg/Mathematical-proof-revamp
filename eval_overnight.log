root=Path('eval/results/tactics');rows=read_rows(root/'results.jsonl')
assert len(rows)==290
outcomes={r['lemma_id']:r['proved'] for r in rows}
for row in rows:
 records=[json.loads((root/'kernel_attempts'/row['lemma_id']/f'attempt_{n}.json').read_text()) for n in range(1,row['attempts_used']+1)]
 assert row['proved']==records[-1]['result']['proved']
 assert all(not r['result']['proved'] for r in records[:-1])
 assert row['proved'] or row['attempts_used']==8
 if row['proved']:
  k=records[-1]['result']['kernel']
  assert k['exit_code']==0 and not k['errors'] and not k['timed_out']
  assert not scan(row['proof_text'],row['aux_lemmas'])
for name in ['lib','fresh']:
 path=Path(f'eval/corpus/{name}.jsonl')
 current=[json.loads(s) for s in path.read_text().splitlines()]
 original=[json.loads(s) for s in subprocess.check_output(['git','show',f'ae1bba8:{path}'],text=True).splitlines()]
 assert all(r['tactic_baseline_proved'] is outcomes[r['id']] for r in current)
 for a,b in zip(current,original):
  a.pop('tactic_baseline_proved');b.pop('tactic_baseline_proved');assert a==b
before={p:p.stat().st_mtime_ns for p in (root/'kernel_attempts').rglob('*.json')}
subprocess.run(['eval/.venv/bin/python','-m','eval.harness.tactics'],check=True)
assert before=={p:p.stat().st_mtime_ns for p in (root/'kernel_attempts').rglob('*.json')}
