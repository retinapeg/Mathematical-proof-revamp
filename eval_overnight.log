+++ b/eval/harness/classify.py
@@ -0,0 +1,27 @@
+"""Stable, ordered error categories; the original error remains in the trace."""
+from __future__ import annotations
+
+import re
+from .kernel import KernelResult
+
+FAILURES = ("parse_error", "unknown_fact", "method_failed", "unfinished_goal",
+            "type_error", "timeout", "cheat_rejected", "provider_error", "other")
+PATTERNS = [
+    ("parse_error", r"Outer syntax error|Inner syntax error|Bad name"),
+    ("unknown_fact", r"Undefined fact|Unknown fact|Undefined type name|Undeclared"),
+    ("type_error", r"Type unification failed|Type error"),
+    ("method_failed", r"Failed to finish proof|Failed to apply initial proof method|empty result sequence"),
+    ("unfinished_goal", r"Failed to refine|unfinished|goal"),
+]
+
+
+def classify(result: KernelResult, *, cheat: bool = False) -> str:
+    if result.timed_out:
+        return "timeout"
+    if cheat:
+        return "cheat_rejected"
+    text = "\n".join(error.message for error in result.errors)
+    for category, pattern in PATTERNS:
+        if re.search(pattern, text, re.IGNORECASE):
+            return category
+    return "other"
diff --git a/eval/harness/kernel.py b/eval/harness/kernel.py
new file mode 100644
index 0000000000000000000000000000000000000000..98f29333f409c0af518b0ad0ac770947d133bd18
--- /dev/null
+++ b/eval/harness/kernel.py
@@ -0,0 +1,66 @@
+"""One attempt, one directory, one headless kernel invocation."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+import re
+
+from eval.probe_m0 import run
+from .scanner import scan
+
+
+@dataclass(frozen=True)
+class KernelError:
+    line: int | None
+    col: int | None
+    message: str
+
+
+@dataclass(frozen=True)
+class KernelResult:
+    exit_code: int
+    stdout: str
+    stderr: str
+    errors: list[KernelError]
+    wall_s: float
+    timed_out: bool
+
+
+def parse_errors(stdout: str, stderr: str = "") -> list[KernelError]:
+    errors: list[KernelError] = []
+    position: int | None = None
+    for line in (stdout + "\n" + stderr).splitlines():
+        if re.match(r"^(Error\b|\*\*\*)", line):
+            loc = re.search(r"\bline (\d+)", line)
+            if loc:
+                position = int(loc[1])
+            col = re.search(r"\bcolumn (\d+)", line)
+            error = KernelError(position, int(col[1]) if col else None,
+                                re.sub(r"^\*\*\*\s?", "", line))
+            if error not in errors:
+                errors.append(error)
+        elif re.search(r"\bFAILED\b|^Unfinished session|^Exception", line):
+            errors.append(KernelError(None, None, line))
+    return errors
+
+
+def check(theory_text: str, workdir: str | Path, timeout_s: float) -> KernelResult:
+    directory = Path(workdir)
+    directory.mkdir(parents=True, exist_ok=True)
+    match = re.match(r"theory\s+([A-Za-z_][\w']*)\b", theory_text)
+    if not match:
+        raise ValueError("Missing safe theory name")
+    path = directory / (match[1] + ".thy")
+    path.write_text(theory_text, encoding="utf-8")
+    outcome = run(["isabelle", "process_theories", "-D", str(directory.resolve()),
+                   "-O", "-o", "quick_and_dirty=false", match[1]], timeout_s)
+    return KernelResult(outcome["exit_code"], outcome["stdout"], outcome["stderr"],
+                        parse_errors(outcome["stdout"], outcome["stderr"]),
+                        outcome["wall_s"], outcome["timed_out"])
+
+
+def proved(result: KernelResult, theory_text: str, statement: str,
+           proof_text: str, aux_lemmas: str = "", target: str = "") -> bool:
+    return (result.exit_code == 0 and not result.timed_out and not result.errors
+            and bool(statement) and statement in theory_text
+            and not scan(proof_text, aux_lemmas, target))
diff --git a/eval/harness/llm.py b/eval/harness/llm.py
new file mode 100644
index 0000000000000000000000000000000000000000..17d7ac6f7ab36d7930401b21bb238eaa42c54df7
--- /dev/null
+++ b/eval/harness/llm.py
@@ -0,0 +1,122 @@
+"""Single-request providers. No implicit HTTP retries and no embedded credentials."""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+import json
+import os
+from pathlib import Path
+import time
+from typing import Protocol
+
+import httpx
+
+
+@dataclass
+class Completion:
+    text: str
+    prompt_tokens: int
+    completion_tokens: int
+    model_id: str | None
+    wall_s: float
+    raw_response: dict | str = field(default_factory=dict)
+    request: dict = field(default_factory=dict)
+    error: str = ""
+    usage_known: bool = True
+
+
+class Provider(Protocol):
+    def complete(self, messages: list[dict], model: str) -> Completion: ...
+
+
+class OpenAICompatible:
+    def __init__(self, *, max_tokens: int = 2048, timeout_s: float = 120,
+                 supports_temperature: bool = True, token_parameter: str = "max_completion_tokens",
+                 transport: httpx.BaseTransport | None = None):
+        if token_parameter not in {"max_tokens", "max_completion_tokens"}:
+            raise ValueError("Invalid output token parameter")
+        self.max_tokens, self.timeout_s = max_tokens, timeout_s
+        self.supports_temperature, self.token_parameter = supports_temperature, token_parameter
+        self.transport = transport
+
+    def endpoint(self) -> tuple[str, dict]:
+        base = os.environ["OPENAI_BASE_URL"].rstrip("/")
+        if not base.endswith("/v1"):
+            base += "/v1"
+        return base + "/chat/completions", {"Authorization": "Bearer " + os.environ["OPENAI_API_KEY"]}
+
+    def payload(self, messages: list[dict], model: str) -> dict:
+        data = {"model": model, "messages": messages, self.token_parameter: self.max_tokens}
+        if self.supports_temperature:
+            data["temperature"] = 0
+        return data
+
+    def decode(self, data: dict) -> tuple[str, int, int, str]:
+        return (data["choices"][0]["message"]["content"], data["usage"]["prompt_tokens"],
+                data["usage"]["completion_tokens"], data["model"])
+
+    def complete(self, messages: list[dict], model: str) -> Completion:
+        start = time.monotonic()
+        payload = self.payload(messages, model)
+        raw: dict | str = ""
+        try:
+            url, headers = self.endpoint()
+            # No redirects, tool calls, streaming, automatic retries or prompt caching.
+            with httpx.Client(timeout=self.timeout_s, transport=self.transport) as client:
+                response = client.post(url, headers=headers, json=payload)
+            raw = response.text
+            response.raise_for_status()
+            raw = response.json()
+            text, pt, ct, actual = self.decode(raw)
+            if not isinstance(text, str) or not actual or min(pt, ct) < 0:
+                raise ValueError("Missing text, exact model id, or valid usage")
+            return Completion(text, pt, ct, actual, time.monotonic()-start, raw, payload)
+        except (httpx.HTTPError, KeyError, ValueError, TypeError, IndexError) as exc:
+            # Never serialize exception text that might contain request headers/keys.
+            status = exc.response.status_code if isinstance(exc, httpx.HTTPStatusError) else None
+            known_free = isinstance(exc, KeyError) and raw == "" or status in {400, 401, 403, 404, 422, 429}
+            return Completion("", 0, 0, None, time.monotonic()-start, raw, payload,
+                              f"{type(exc).__name__}; HTTP status={status}", known_free)
+
+
+class Anthropic(OpenAICompatible):
+    def endpoint(self) -> tuple[str, dict]:
+        return "https://api.anthropic.com/v1/messages", {
+            "x-api-key": os.environ["ANTHROPIC_API_KEY"], "anthropic-version": "2023-06-01"}
+
+    def payload(self, messages: list[dict], model: str) -> dict:
+        data = {"model": model, "max_tokens": self.max_tokens,
+                "system": "\n".join(m["content"] for m in messages if m["role"] == "system"),
+                "messages": [m for m in messages if m["role"] != "system"]}
+        if self.supports_temperature:
+            data["temperature"] = 0
+        return data
+
+    def decode(self, data: dict) -> tuple[str, int, int, str]:
+        usage = data["usage"]
+        return ("".join(b["text"] for b in data["content"] if b["type"] == "text"),
+                usage["input_tokens"], usage["output_tokens"], data["model"])
+
+
+class Fake:
+    def __init__(self, policy: str, proof: str = ""):
+        if policy not in {"held_out", "simp", "sorry", "garbage"}:
+            raise ValueError("Unknown fake policy")
+        self.policy, self.proof, self.calls = policy, proof, 0
+
+    @classmethod
+    def from_corpus(cls, policy: str, paths: list[str], lemma_id: str) -> Fake:
+        if policy != "held_out":
+            return cls(policy)
+        for path in paths:
+            for line in Path(path).read_text().splitlines():
+                row = json.loads(line)
+                if row["id"] == lemma_id:
+                    return cls(policy, row["held_out_proof"])
+        raise ValueError("Fake held-out fixture not found")
+
+    def complete(self, messages: list[dict], model: str) -> Completion:
+        self.calls += 1
+        text = {"held_out": self.proof, "simp": "by simp", "sorry": "sorry",
+                "garbage": "not an XML proof"}[self.policy]
+        response = text if self.policy == "garbage" else f"<proof>{text}</proof>"
+        return Completion(response, 0, 0, "fake/" + self.policy, 0, {"text": response})
diff --git a/eval/harness/runner.py b/eval/harness/runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae132b9b41841154eac615f589d19d0df0bb7e24
--- /dev/null
+++ b/eval/harness/runner.py
@@ -0,0 +1,179 @@
+"""Bounded process-pool orchestration. Only the parent appends result rows."""
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import FIRST_COMPLETED, ProcessPoolExecutor, wait
+from dataclasses import asdict
+import fcntl
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import subprocess
+
+from .agent import atomic_json, run_task
+from .budget import Budget, BudgetStop
+from .schema import Result, Task, key
+
+
+def load_tasks(config: dict) -> list[Task]:
+    tasks = [Task.from_row(json.loads(line)) for path in config["corpus"]
+             for line in Path(path).read_text().splitlines() if line.strip()]
+    if "lemma_ids" in config:
+        wanted = set(config["lemma_ids"])
+        tasks = [t for t in tasks if t.id in wanted]
+        if {t.id for t in tasks} != wanted:
+            raise ValueError("Unknown configured lemma id")
+    if "lib_limit" in config:
+        lib = sorted((t for t in tasks if t.stratum == "lib"), key=lambda t: t.id)
+        keep = {t.id for t in lib[:config["lib_limit"]]}
+        tasks = [t for t in tasks if t.stratum != "lib" or t.id in keep]
+    if len({t.id for t in tasks}) != len(tasks):
+        raise ValueError("Duplicate lemma ids")
+    for t in tasks:
+        if not re.fullmatch(r"[A-Za-z0-9_./'-]+", t.id) or ".." in Path(t.id).parts or t.id.startswith("/"):
+            raise ValueError("Unsafe lemma id")
+    return tasks
+
+
+def read_rows(path: Path) -> list[dict]:
+    if not path.exists():
+        return []
+    rows = []
+    for line in path.read_text().splitlines():
+        if line.strip():
+            row = json.loads(line)
+            Result(**row).validate()
+            rows.append(row)
+    if len({key(r) for r in rows}) != len(rows):
+        raise ValueError("Duplicate result keys")
+    return rows
+
+
+def validate_config(config: dict) -> None:
+    if not re.fullmatch(r"[A-Za-z0-9_-]+", config["run_id"]):
+        raise ValueError("Unsafe run id")
+    for name in ("max_usd", "max_hours"):
+        value = config.get(name, 8 if name == "max_hours" else -1)
+        if not math.isfinite(value) or value < 0:
+            raise ValueError(f"Invalid {name}")
+    if config["workers"] < 1 or config["kernel_timeout_s"] <= 0:
+        raise ValueError("Workers and kernel timeout must be positive")
+    seen = set()
+    for condition in config["conditions"]:
+        identity = (condition["model"], condition["max_attempts"])
+        if identity in seen or condition["max_attempts"] < 1:
+            raise ValueError("Duplicate or invalid condition")
+        seen.add(identity)
+        if condition["provider"] not in {"fake", "tactics", "openai_compatible", "anthropic"}:
+            raise ValueError("Unknown provider")
+        if condition["provider"] not in {"fake", "tactics"}:
+            rates = config["cost_usd_per_m"][condition["model"]]
+            if any(not math.isfinite(rates[k]) or rates[k] < 0 for k in ("prompt", "completion")):
+                raise ValueError("Missing/invalid explicit model pricing")
+
+
+def execute(task: Task, condition: dict, config: dict, metadata: dict,
+            offset: int, root: Path, keep_work: bool) -> dict | None:
+    try:
+        if condition["provider"] == "tactics":
+            from .tactics import run_tactics
+            return run_tactics(task, condition, config, metadata, offset, root, keep_work)
+        return run_task(task, condition, config, metadata, offset, root, keep_work)
+    except BudgetStop as exc:
+        atomic_json(root / config["run_id"] / "stopped" / task.id / f"condition_{offset}.json",
+                    {"reason": str(exc), "condition": condition})
+        return None
+
+
+def run(config: dict, root: Path = Path("eval/results"), keep_work: bool = False) -> dict:
+    validate_config(config)
+    tasks = load_tasks(config)
+    directory = root / config["run_id"]
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / "run.lock").open("w") as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        metadata = {
+            "isabelle_version": subprocess.check_output(["isabelle", "version"], text=True).strip(),
+            "git_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()}
+        fingerprint = hashlib.sha256(json.dumps(
+            [config, [asdict(t) for t in tasks]], sort_keys=True).encode()).hexdigest()
+        manifest_path = directory / "manifest.json"
+        if manifest_path.exists():
+            if json.loads(manifest_path.read_text())["fingerprint"] != fingerprint:
+                raise ValueError("Config/corpus changed; use a new run_id")
+        else:
+            atomic_json(manifest_path, {"config": config, "fingerprint": fingerprint,
+                                       "tasks": [asdict(t) for t in tasks], **metadata})
+        path = directory / "results.jsonl"
+        # Preserve an incomplete append, then recover only the unterminated tail.
+        if path.exists() and path.read_bytes() and not path.read_bytes().endswith(b"\n"):
+            data = path.read_bytes()
+            tail = data.rsplit(b"\n", 1)[-1]
+            (directory / "interrupted_tail.json").write_bytes(tail)
+            path.write_bytes(data[:len(data)-len(tail)])
+        rows = read_rows(path)
+        completed = {key(r) for r in rows}
+        jobs, offset = [], 0
+        for condition in config["conditions"]:
+            for task in tasks:
+                identity = (config["run_id"], task.id, condition["model"], condition["max_attempts"])
+                if identity not in completed:
+                    jobs.append((task, condition, config, metadata, offset, root, keep_work))
+            offset += condition["max_attempts"]
+        budget = Budget(directory / "budget.sqlite", config["max_usd"], config.get("max_hours", 8))
+        pending, iterator, written, stopped = {}, iter(jobs), 0, False
+        with ProcessPoolExecutor(max_workers=config["workers"]) as pool, path.open("a") as out:
+            def submit_one() -> bool:
+                nonlocal stopped
+                if budget.remaining_s() <= 0:
+                    stopped = True
+                    return False
+                job = next(iterator, None)
+                if job is None:
+                    return False
+                pending[pool.submit(execute, *job)] = job[0].id
+                return True
+            for _ in range(config["workers"]):
+                if not submit_one():
+                    break
+            while pending:
+                ready, _ = wait(pending, return_when=FIRST_COMPLETED)
+                for future in ready:
+                    pending.pop(future)
+                    row = future.result()
+                    if row is None:
+                        stopped = True
+                    else:
+                        out.write(json.dumps(row, ensure_ascii=False) + "\n")
+                        out.flush()
+                        os.fsync(out.fileno())
+                        written += 1
+                        print(row["lemma_id"], json.dumps(row["condition"], separators=(",", ":")),
+                              row["proved"], row["attempts_used"], row["failure_class"],
+                              f'{row["usd_cost"]:.6f}', flush=True)
+                    if not stopped:
+                        submit_one()
+        status = {"status": "no_conditions" if not config["conditions"] else
+                  "budget_or_interrupted_call" if stopped else "complete",
+                  "written": written, "completed": len(rows) + written,
+                  "planned": len(tasks)*len(config["conditions"]), "usd_reserved_or_spent": budget.total(),
+                  **metadata}
+        atomic_json(directory / "status.json", status)
+        return status
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("config")
+    parser.add_argument("--keep-work", action="store_true")
+    args = parser.parse_args()
+    status = run(json.loads(Path(args.config).read_text()), keep_work=args.keep_work)
+    if status["status"] == "no_conditions":
+        raise SystemExit(2)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/eval/harness/scanner.py b/eval/harness/scanner.py
new file mode 100644
index 0000000000000000000000000000000000000000..b3439fb270109f131100b45ca4e06159fd2bdb79
--- /dev/null
+++ b/eval/harness/scanner.py
@@ -0,0 +1,80 @@
+"""Conservative lexical rejection, including forbidden words in comments.
+
+This is a defence in addition to quick_and_dirty=false, not an Isar parser.
+False positives are preferable to executing model-supplied ML or declarations.
+"""
+from __future__ import annotations
+
+import re
+
+FORBIDDEN = set("""sorry oops axiomatization quick_and_dirty skip_proof cheat
+ML ML_prf ML_val setup declare consts defs overloading code_printing theory
+imports begin end lemmas translations notation no_notation hide_fact hide_const
+sledgehammer nitpick oracle axioms tactic raw_tactic method_setup attribute_setup
+local_setup ML_file ML_command simproc_setup syntax no_syntax abbreviation
+definition typedef type_synonym locale class instantiation interpretation
+sublocale bundle unbundle external_file SML SML_file""".lower().split())
+WORD = re.compile(r"(?<![\w'])[A-Za-z_][\w']*")
+
+
+def balanced(text: str) -> bool:
+    """No lexical construct may cross the harness-owned statement boundary."""
+    stack: list[str] = []
+    i = 0
+    while i < len(text):
+        top = stack[-1] if stack else ""
+        if top == '"':
+            if text[i:i+2] in {'\\"', '\\\\'}:
+                i += 2
+                continue
+            if text[i] == '"':
+                stack.pop()
+        elif top == "(*":
+            if text.startswith("(*", i):
+                stack.append("(*")
+                i += 2
+                continue
+            if text.startswith("*)", i):
+                stack.pop()
+                i += 2
+                continue
+        else:
+            found = False
+            for opening, closing in (("‹", "›"), (r"\<open>", r"\<close>"), ("(*", "*)")):
+                if text.startswith(opening, i):
+                    stack.append(opening)
+                    i += len(opening)
+                    found = True
+                    break
+                if text.startswith(closing, i):
+                    if top != opening:
+                        return False
+                    stack.pop()
+                    i += len(closing)
+                    found = True
+                    break
+            if found:
+                continue
+            if text[i] == '"' and not stack:
+                stack.append('"')
+        i += 1
+    return not stack
+
+
+def scan(proof_text: str, aux_lemmas: str = "", target: str = "") -> list[str]:
+    reasons = []
+    for label, text in (("proof", proof_text), ("aux", aux_lemmas)):
+        if len(text) > 8000:
+            reasons.append(f"{label} exceeds 8000 characters")
+        if not balanced(text):
+            reasons.append(f"{label}: unbalanced lexical construct")
+        for token in WORD.findall(text):
+            if token.lower() in FORBIDDEN or token.lower().startswith(("cheat_", "skip_proof")):
+                reasons.append(f"{label}: forbidden token {token}")
+        # Reject control characters and symbol-encoded keyword obfuscation.
+        if any(ord(ch) < 32 and ch not in "\n\r\t" for ch in text):
+            reasons.append(f"{label}: control character")
+    names = re.findall(r'\b(?:lemma|theorem|corollary)\s+"?([\w\']+)', aux_lemmas)
+    if target and target in names:
+        reasons.append("auxiliary lemma shadows target")
+    return sorted(set(reasons))
diff --git a/eval/harness/schema.py b/eval/harness/schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..394e7a8b9232ac3031a556e89cb071b8ab226a79
--- /dev/null
+++ b/eval/harness/schema.py
@@ -0,0 +1,74 @@
+"""Public task boundary and validated result records."""
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import math
+from .classify import FAILURES
+
+
+@dataclass(frozen=True)
+class Task:
+    id: str
+    stratum: str
+    imports: list[str]
+    statement: str
+    orig_proof_lines: int
+
+    @classmethod
+    def from_row(cls, row: dict) -> Task:
+        # Deliberate allowlist: private corpus fields cannot enter the agent.
+        return cls(**{name: row[name] for name in cls.__dataclass_fields__})
+
+
+@dataclass
+class Result:
+    run_id: str
+    lemma_id: str
+    stratum: str
+    condition: dict
+    proved: bool
+    attempts_used: int
+    failure_class: str | None
+    final_error: str
+    proof_text: str
+    proof_lines: int
+    methods_used: dict[str, int]
+    aux_lemmas: str
+    prompt_tokens: int
+    completion_tokens: int
+    usd_cost: float
+    llm_wall_s: float
+    kernel_wall_s: float
+    model_id_returned: str | None
+    isabelle_version: str
+    git_sha: str
+    timestamp: str
+    # Needed to reproduce attempt-level rates and difficulty curves from rows.
+    orig_proof_lines: int
+    attempt_failures: dict[str, int]
+    model_ids_returned: list[str]
+    cost_is_upper_bound: bool = False
+    provider: str = ""
+    gpu_hours: float | None = None
+
+    def validate(self) -> None:
+        assert type(self.proved) is bool
+        assert self.failure_class is None if self.proved else self.failure_class in FAILURES
+        assert 1 <= self.attempts_used <= self.condition["max_attempts"]
+        assert len(self.final_error) <= 500
+        assert self.proof_lines == len(self.proof_text.splitlines())
+        for number in (self.usd_cost, self.llm_wall_s, self.kernel_wall_s):
+            assert math.isfinite(number) and number >= 0
+        assert self.prompt_tokens >= 0 and self.completion_tokens >= 0
+        assert set(self.attempt_failures) <= set(FAILURES)
+        assert sum(self.attempt_failures.values()) == self.attempts_used - int(self.proved)
+        assert self.isabelle_version and len(self.git_sha) == 40
+
+    def to_dict(self) -> dict:
+        self.validate()
+        return asdict(self)
+
+
+def key(row: dict) -> tuple[str, str, str, int]:
+    return (row["run_id"], row["lemma_id"], row["condition"]["model"],
+            row["condition"]["max_attempts"])
diff --git a/eval/harness/tactics.py b/eval/harness/tactics.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b74df45f94d3f154d6c79c59e09b5c848e58b9d
--- /dev/null
+++ b/eval/harness/tactics.py
@@ -0,0 +1,69 @@
+"""The fixed, ordered no-LLM tactic battery."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .agent import assess, atomic_json, summarize
+from .budget import Budget, BudgetStop
+from .schema import Task
+
+TACTICS = ["by simp", "by auto", "by blast", "by fastforce", "by force",
+           "by linarith", "by arith", "by (simp add: algebra_simps)"]
+
+
+def run_tactics(task: Task, condition: dict, config: dict, metadata: dict,
+                offset: int, root: Path, keep_work: bool = False) -> dict:
+    if condition["max_attempts"] != 8:
+        raise ValueError("The tactic baseline is exactly eight ordered methods")
+    budget = Budget(root / config["run_id"] / "budget.sqlite", 0, config.get("max_hours", 8))
+    records = []
+    for attempt, proof in enumerate(TACTICS, 1):
+        path = root / config["run_id"] / "kernel_attempts" / task.id / f"attempt_{attempt}.json"
+        if path.exists():
+            record = json.loads(path.read_text())
+        else:
+            remaining = budget.remaining_s()
+            if remaining <= 0:
+                raise BudgetStop("tactic run wall-clock limit")
+            outcome = assess(task, proof, "", config["run_id"], offset+attempt,
+                             root, min(30, remaining), keep_work)
+            record = {"result": outcome, "tactic": proof, "attempt": attempt,
+                      "usd_cost": 0, **metadata}
+            atomic_json(path, record)
+        records.append(record)
+        if record["result"]["proved"]:
+            break
+    return summarize(task, condition, config["run_id"], records, metadata)
+
+
+def update_corpus(paths: list[str], rows: list[dict]) -> None:
+    outcomes = {r["lemma_id"]: r["proved"] for r in rows
+                if r["condition"] == {"model": "tactics", "max_attempts": 8}}
+    for path_string in paths:
+        path = Path(path_string)
+        corpus = [json.loads(line) for line in path.read_text().splitlines()]
+        for row in corpus:
+            row["tactic_baseline_proved"] = outcomes.get(row["id"])
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text("".join(json.dumps(row, ensure_ascii=False)+"\n" for row in corpus))
+        temporary.replace(path)
+
+
+def main() -> None:
+    from .runner import read_rows, run
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", default="eval/configs/tactics.json")
+    parser.add_argument("--keep-work", action="store_true")
+    args = parser.parse_args()
+    config = json.loads(Path(args.config).read_text())
+    status = run(config, keep_work=args.keep_work)
+    rows = read_rows(Path("eval/results") / config["run_id"] / "results.jsonl")
+    update_corpus(config["corpus"], rows)
+    if status["completed"] != status["planned"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
